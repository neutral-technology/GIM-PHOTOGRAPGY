<%= form_with(model: receipt, local: true, class: "gap-3 items-center align-center w-full space-y-5", html: { 'x-data': 'submitOnEnter', 'x-ref': 'form' }) do |f| %>
  <div class="flex gap-3 justify-between">
    <div class="w-full">
      <%= f.label :shooting_type, "Type de photo", class:"text-gray font-normal" %>
      <%= f.select :shooting_type, Receipt.shooting_types.keys.map { |w| [w.titleize, w] }, {}, class: "form-select" %>
    </div>
    <div class="w-full">
      <%= f.label :photos_count, "Photos", class:"text-gray font-normal" %>
      <%= f.number_field :photos_count, class: "form-control form-input", placeholder: "nombre de photo" %>
    </div>

  </div>
  <div class="flex justify-between gap-3">

    <div class="w-full">
      <%= f.label :amount, "Montant Payé", class:"text-gray font-normal" %>
      <%= f.number_field :amount, step: 0.01, class: "form-control form-input", placeholder: "en franc ou en dollar" %>
    </div>
    <div class="w-full">
      <%= f.label :date, "Date de Paiement", class:"text-gray font-normal" %>
      <%= f.date_field :date, class: "form-control form-input" %>
    </div>
  </div>


  <div class="flex flex-col gap-2 items-center justify-end">
    <%= f.button type: "submit",
        class: " btn btn-primary justify-center hover:text-blue-600 items-center  flex w-full bottom-7 text-white p-2 rounded-full shadow-md transition duration-300 ease-in-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100" do %>
        Valider
    <% end %>
    <div>
      <%= link_to "retour", users_profile_path, class: "cursor-pointer" %>
    </div>
  </div>
<% end %>
