
<%= form_with(model: receipt, local: true, class: "gap-3 items-center align-center w-full space-y-5") do |f| %>


  <div class="flex justify-between gap-3">
   <div class="w-full relative"
     data-controller="client-search"
      data-client-search-clients-value="<%= json_escape(@clients.map { |c|
        { id: c.id, name: c.name, tel: c.tel }
      }.to_json) %>">

      <%= f.label :client_id, "Client", class: "text-gray font-normal" %>
      <input type="text"
            placeholder="Tier par numéro"
            class="form-select w-full"
            data-client-search-target="input"
            data-action="input->client-search#search" />
      <%# Inline Error for Client %>
      <% if receipt.errors[:client].any? %>
        <p class="text-red-500 text-xs mt-1"><%= receipt.errors[:client].first %></p>
      <% end %>
      <!-- Hidden -->
      <%= f.hidden_field :client_id, data: { client_search_target: "hidden" } %>
      <div data-client-search-target="results"
          class="absolute z-50 bg-white border w-full overflow-y-auto rounded shadow">
      </div>
    </div>
    <div class="w-full">
      <%= f.label :shooting_type, "Type de photo", class:"text-gray font-normal" %>
      <%= f.select :shooting_type, Receipt.shooting_types.keys.map { |w| [w.titleize, w] }, {}, class: "form-select" %>
    </div>
    <div class="w-70">
      <%= f.label :photos_count, "Photos", class:"text-gray font-normal" %>
      <%= f.number_field :photos_count, class: "form-control form-input", placeholder: "Nbre" %>
    </div>
  </div>

  <div class="flex justify-between gap-3">
    <div class="w-full">
      <%= f.label :amount, "Montant Total en", class:"text-gray font-normal" %>
      <%= f.number_field :amount, step: :any, class: "form-control form-input", placeholder: "Montant total" %>
      <% if receipt.errors[:amount].any? %>
        <p class="text-red-500 text-xs mt-1">Montant <%= receipt.errors[:amount].first %></p>
      <% end %>
    </div>
   <div class="w-full">
      <%= f.label :currency, "Devise", class: "text-gray font-normal" %>
      <%= f.select :currency,
          options_for_select(Receipt.currencies.keys.map { |c| [c.upcase, c] }, f.object.currency),
          { include_blank: 'Choisir la devise' },
          class: "form-select", id: "currency_select" %>
      <% if receipt.errors[:amount].any? %>
        <p class="text-red-500 text-xs mt-1">Montant <%= receipt.errors[:amount].first %></p>
      <% end %>
    </div>
  </div>
  
  <div class="flex justify-between gap-3">
    <div class="flex flex-col gap-1 w-full">
      <div class="w-full">
        <%= f.label :amount_paid, "Montant Payé en", class:"text-gray font-normal" %>
        <%= f.number_field :amount_paid, step: :any, class: "form-control form-input",  id: "amount_paid_input", placeholder: "Montant payé" %>
      </div>
      <div class="flex gap-2 items-center">
        <button type="button" class="btn btn-secondary" onclick="fillFullAmount()">
          Payer total💰
        </button>
      </div>
    </div>
   <div class="w-full">
      <%= f.label :paid_currency, "Devise du paiement", class: "text-gray font-normal" %>
      <%= f.select :paid_currency,
          options_for_select(Receipt.paid_currencies.keys.map { |c| [c.upcase, c] }, f.object.paid_currency),
          { include_blank: 'Choisir la devise' },
          class: "form-select", id: "paid_currency_select" %>
    </div>
  </div>

  <div class="mb-3" id="exchange_rate_wrapper">
    <%= f.label :exchange_rate, "Taux de change (1 USD = ? CDF)" %>
    <%= f.number_field :exchange_rate, step: :any, class: "form-input", value: 2200 %>
  </div>

  <div class="flex flex-wrap justify-between gap-3">
    <div class="w-full">
      <%= f.label :date, "Date", class:"text-gray font-normal" %>
      <%= f.date_field :date, class: "form-control form-input" %>
    </div>
    <div class="w-full">
      <%= f.label :photographer_id, "Photographe", class: "text-gray font-normal" %>
      <%= f.collection_select :photographer_id,
            @photographers,
            :id,
            :name,
            { prompt: "Sélectionner" },
            class: "form-select" %>
    </div>
    <div class="w-full">
      <%= f.label :created_by_id, "Enregistré par", class: "text-gray font-normal" %>
      <%= f.collection_select :created_by_id,
            @photographers,
            :id,
            :name,
            { prompt: "Sélectionner" },
            class: "form-select", required: true %>
      <%# Inline Error for Created By %>
      <% if receipt.errors[:created_by].any? %>
        <p class="text-red-500 text-xs mt-1">Champs obligatoire</p>
      <% end %>
    </div>
  </div>

  <div class="flex border flex-col gap-2 items-center justifyend">
    <%= f.button "Valider", type: "submit", class: "btn btn-primary w-full" %>
    <%# --- MAIN ERROR BLOCK --- %>
    <% if receipt.errors.any? %>
  <div class="bg-red-50 border-l-4 border-red-500 p-4 w-full my-4 rounded-md">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <span class="text-red-500">⚠️</span>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-bold text-red-800">
          Il y a <%= receipt.errors.count %> <%= "erreur".pluralize(receipt.errors.count) %> :
        </h3>
        <ul class="mt-1 list-disc list-inside text-xs text-red-700">
          <%# Use uniq to avoid showing "Amount" errors multiple times %>
          <% receipt.errors.full_messages.uniq.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
  </div>

<% end %>


<script>
  function toggleExchangeRate() {
    const currency = document.getElementById("currency_select").value;
    const paid = document.getElementById("paid_currency_select").value;
    const wrapper = document.getElementById("exchange_rate_wrapper");

    if (currency === paid) {
      wrapper.style.display = "none";
    } else {
      wrapper.style.display = "block";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    toggleExchangeRate();

    document.getElementById("currency_select").addEventListener("change", toggleExchangeRate);
    document.getElementById("paid_currency_select").addEventListener("change", toggleExchangeRate);
  });
</script>
<script>
  function fillFullAmount() {
    const amount = document.querySelector('[name="receipt[amount]"]').value;
    document.getElementById("amount_paid_input").value = amount;
  }
</script>