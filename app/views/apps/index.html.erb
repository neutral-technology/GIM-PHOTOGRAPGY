        <button id="next-slide" class="absolute top-1/2 right-4 -translate-y-1/2 p-3 bg-white/50 text-gray-800 rounded-full shadow-lg hover:bg-white transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
