  </div>


  <!-- Image Carousel/Slider Section -->
  <div class="flex bg-gray-100 pt-16 px-4 mb-8">
    <div class="mx-auto py-8">
      <h2 class="mb-16 text-4xl font-bold text-center text-gray-900">Une touche sans contredit</h2>
      <div class="relative w-full max-w-4xl mx-auto">
        <!-- Carousel track -->
        <div id="image-carousel" class="flex overflow-hidden rounded-xl shadow-xl">
          <!-- Placeholder images - Replace these with your own! -->
          <% if @carousel_images.present? %>
            <% @carousel_images.each_with_index do |image, index| %>
              <%= image_tag image.photo, class: "w-full h-auto object-cover transition-opacity duration-500 #{"hidden" unless index == 0}", style: 'height: 500px;' %>
            <% end %>
