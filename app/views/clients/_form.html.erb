<%= form_with(model: client, class: "gap-3 items-center align-center w-full space-y-5") do |form| %>
  <div>
    <div class="w-full mb-3">
      <%= form.label 'Nom du client', class: "block text-white-dark" %>
      <%= form.text_field :name, class: "form-input font-normal" %>
    </div>
    <div>
      <%= form.label 'Numéro', class: "block text-white-dark" %>
      <%= form.number_field :tel, class: "form-input font-normal" %>
    </div>
    <% if client.errors.any? %>
      <div class="text-xs mt-1" style="color: red;">
          <p>veillez entrer un nom valid</p>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-end">
    <%= form.button type: "submit",
        class: " btn btn-primary justify-center hover:text-blue-400 items-center  flex w-full bottom-7 text-white p-2 rounded-full shadow-md transition duration-300 ease-in-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100" do %>
        Valider
    <% end %>  </div>
<% end %>
