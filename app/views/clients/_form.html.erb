<%= form_with(model: client, class: "gap-3 items-center align-center w-full space-y-5") do |form| %>
  <div>
    <div class="w-full mb-3">
      <%= form.label 'Nom du client', class: "block text-white-dark" %>
      <%= form.text_field :name, class: "form-input font-normal", required: true %>
      <% if client.errors[:name].any? %>
        <p class="text-[10px] text-red-500 mt-1 italic">
          Nom <%= client.errors[:name].first %>
        </p>
      <% end %>
    </div>
    <div class="mb-12">
      <%= form.label 'Numéro', class: "block text-white-dark mb-2" %>
      <%= form.number_field :tel, id: "phone", class: "form-input border rounded px-2 py-1 w-full", placeholder: "Numero de telephone", required: true %>
      <span class="text-xs my-5 text-gray badge bg-primary-light px-2 rounded">  Le préfixe 243 sera ajouté automatiquement</span>
      <% if client.errors[:tel].any? %>
        <p class="text-[10px] text-danger mt-1 italic">
          * <%= client.errors[:tel].first %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-end mt-8" style="margin-top: 34px;">
    <%= form.button type: "submit",
        class: " btn btn-primary justify-center hover:text-blue-400 items-center  flex w-full bottom-7 text-white p-2 rounded-full shadow-md transition duration-300 ease-in-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100" do %>
        Valider
    <% end %>  </div>
<% end %>
