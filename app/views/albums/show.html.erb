<div class="container mx-auto py-4 max-w-4xl">
  <% if policy(@album).edit? %>
    <div class="my-8">
      <%# --- SECTION A: ADMIN TOOLS (Only visible to Photographer/Admin) --- %>
      <%# 1. Header Section: Identity & CRUD Actions %>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100  pb-6 mb-6">
        <div class= "">
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 tracking-tight uppercase"><%= @album.name %></h1>
          <div class="flex items-center gap-2 mt-1">
            <span class="px-2 py-0.5 text-indigo-600 text-xs font-bold rounded-full uppercase">Client</span>
            <span class="text-gray-600 font-medium"><%= @album.client.name %></span>
          </div>
        </div>

        <%#   ACTION BTNS %>
        <div class="flex items-center gap-3">
          <%= link_to "+ facture", new_receipt_path, class: "btn btn-primary hover:underline" %>
          <%= link_to edit_album_path(@album), class: "flex btn btn-primary items-center roundedxl gap-2 px-4 py-2 text-sm transition-all shadow-sm" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
            Editer
          <% end %>
          
          <%= button_to album_path(@album), method: :delete, form: { data: { turbo_confirm: "Supprimer cet album définitivement ?" } }, class: "flex items-center btn btn-danger gap-2 px-4 py-2 text-sm  roundedxl hover:bg-red-100 dark:hover:bg-red-900/40 transition-all shadow-sm" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Supprimer
          <% end %>
          </ul>
        </div>
      </div>

      <%# 2. Security Section: Password Generation %>
      <div class="flex flex-wrap justify-between gap-8 items-center">
        <div class="space-y-4">
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" /></svg>
            Sécurité de l'album
          </div>
          
          <div class="flex flex-wrap items-center gap-3">
            <%= button_to generate_password_album_path(@album), method: :patch, class: "px-5 py-2.5 text-sm font-bold rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 btn btn-primary rounded-md shadow-sm hover:bg-blue-700 cursor-pointer" do %>
              <span>Générer un mot de passe</span>
            <% end %>

            <%# Unified Password Display (Flash or Instance Variable) %>
            <% display_pwd = @generated_password || flash[:generated_password] %>
            <% if display_pwd.present? %>
              <div class="flex items-center animate-fade-in-down">
                <div class="flex items-center gap-3 bg-success border border-green-200 p-2 pr-4 rounded-xl">
                  <span id="password-text" class="font-mono font-bold text-green-700 dark:text-green-400 bg-white dark:bg-gray-900 px-3 py-1 rounded-lg border border-green-200 dark:border-green-700">
                    <%= display_pwd %>
                  </span>
                  <button onclick="copyPassword()" class="hover:text-green-800  transition-colors" title="Copier">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </button>
                  <span class="text-[10px] text-white font-bold uppercase sm:inline">Copiable</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# 3. Share Section %>
        <div class="flex flex-col lg:items-end justify-center h-full space-y-4">
          <p class="text-sm font-medium">Envoyer l'accès au client</p>
          <div>
            <%= link_to whatsapp_album_link(@client, @album, current_user),
                    target: "_blank",
                    class: "btn-success border flex justify-center items-center gap-2 p-2 rounded w-36 text-xs",
                    style: "width: 150px;" do %>
                    <svg class="w-5 h-5 fill-white " viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.319 1.592 5.448 0 9.886-4.438 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.815-.981z"/></svg>
                    WhatsApp
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-8 panel sm:w-[480px] max-w-lg w-full">
      <%= form_with(model: [@album, @image], data: { turbo: false }, local: true) do |form| %>
        <div class="flex flex-col">
          <%= form.label :photo, "Importer les images", class: "block text-sm font-medium" %>
          <div class="flex gap-3 mx-0 justify-between">
            <%= form.file_field :photo, multiple: true, class: "cursor-pointer w-full text-sm form-input file:cursor-pointer file:py-2 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100" %>
            <%= form.submit "Valider", class: "btn btn-primary cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <%# --- SECTION B: PUBLIC VIEW (Title & Photos) --- %>
  <div class="text-center my-16" style="margin-top: 30px;">
    <% if @album.public? && !user_signed_in? %>
       <h1 class="text-4xl font-extrabold text-indigo-600">Fragments d'Émotions</h1>
       <p class="italic mt-2 mx-auto mb-10" style="width: 70%;">
        "Chaque cliché est une histoire suspendue dans le temps.
        Explorez cette galerie où la lumière rencontre l'instant pour
        créer des souvenirs éternels."
       </p>
    <% end %>
  </div>

    <% if @images.present? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 justify-center">
        <% @images.each do |image| %>
            <div class="bg-white rounded-lg shadow overflow-hidden relative group">
              
              <%= image_tag image.photo, class: "w-full h-auto object-cover" %>

              <% if policy(@album).update? %>
                <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition">
                  <%= button_to album_image_path(@album, image),
                        method: :delete,
                        form: { data: { turbo_confirm: "Supprimer cette image ?" } },
                        data: { turbo: false },
                        class: "bg-danger hover:bg-white hover:text-danger text-white p-1.5 rounded-full shadow-md transition" do %>
                    
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                        viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12" />
                    </svg>

                  <% end %>
                </div>
              <% end %>

            </div>
          <% end %>
      </div>
    <% else %>
        <div class="text-center w-full my-20">
          <p class="font-medium text-lg">
            📸 Aucune photo pour le moment
          </p>
          <p class="text-sm text-gray-400 mt-1">L'album sera bientôt mis à jour.</p>
        </div>
    <% end %>
  </div>
</div>