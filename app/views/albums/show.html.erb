<div class="container mx-auto p-4 max-w-4xl">
  <div class="flex flex-col mb-6">
    <h1 class="text-3xl font-bold text-gray-900"><%= @album.name %></h1>
    <span class="text-sm text-gray-600">( Client: <%= @album.client.name %> )</span>
  </div>
  <% if @generated_password %>
    <div class="border  border-l-4 border-indigo-50 p-4 mb-8" role="alert">
      <div class="flex justify-between items-center">
        <p class="font-bold">Nouveau mot de passe généré:</p>
        <div class="flex items-center space-x-2 border">
          <span id="password-text" class="font-mono text-lg"><%= @generated_password %></span>
          <button onclick="copyPassword()" class="hover:text-indigo-800 transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <div class=" items-center mb-4">
    <p>Mot de passe pour l'album</p>
    <div class="flex gap-3">
      <%= button_to "Générer", generate_password_album_path(@album), method: :patch, class: "  btn btn-primary border-transparent mb-3 rounded-md shadow-sm bg-blue-600 hover:bg-blue-700 cursor-pointer" %>
      <% if flash[:generated_password].present? %>
        <div class="flex items-center space-x-2 gap-3 mb-3 ">
          <span id="password-text" class="border bg-white hover:text-primary hover:bg-black p-2 rounded-xl px-2 text-md"><%= flash[:generated_password] %></span>
          <p  class="bg-white hover:text-primary hover:bg-black p-2 rounded-xl">Notez le quelque part</p>
        </div>
      <% end %>
    </div>
    <div>
      <%= link_to "Partager via WhatsApp",
              whatsapp_album_link(@client, @album),
              target: "_blank",
              class: "btn-success p-2 rounded mt-10 mb-4 w-36 text-xs" %>

    </div>
  </div>
  <div class="mb-8 panel sm:w-[480px] max-w-lg w-full">
    <%= form_with(model: [@album, @image], data: { turbo: false }, local: true) do |form| %>
      <div class="flex flex-col">
        <%= form.label :photo, "Importer les images", class: "block text-sm font-medium" %>
        <div class="flex gap-3 mx-0 justify-between">
          <%= form.file_field :photo, multiple: true, class: "cursor-pointer w-full text-sm form-input file:cursor-pointer file:py-2 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100" %>
          <%= form.submit "Valider", class: "btn btn-primary cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
    <% if @images.present? %>
      <% @images.each do |image| %>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <%= image_tag image.photo, class: "w-full h-auto object-cover" %>
        </div> 
      <% end %>
    <% else %>
        <p class="m-8 mb-16 mx-auto justify-center">Aucune photo pour le moment, veillez ajouter</p>
    <% end %>
  </div>
</div>