<%= form_with(model: album, class: "gap-3 items-center align-center w-full space-y-5", html: { 'x-data': 'submitOnEnter', 'x-ref': 'form' }) do |form| %>
  <% if album.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
      <h2 class="font-bold">Erreur !</h2>
      <ul>
        <% album.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :client_id, "Assigner un client", class: "block text-white-dark" %>
    <%= form.select :client_id,
          options_for_select(@clients.map { |c| [c.name, c.id] }, album.client_id), 
          { include_blank: 'Sélectionner le client' },
          class: "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-gray-900" %>
  </div>

  <%# 2. Public Status Checkbox %>
  <div class="flex items-start p-4 bg-gray-50 rounded-lg border border-gray-200 dark:border-gray-700">
    <div class="flex items-center h-5">
      <%# Rails check_box defaults to false if the attribute is nil %>
      <%= form.check_box :public, class: "w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer" %>
    </div>
    <div class="ml-3 text-sm leading-6">
      <%= form.label :public, "Rendre l'album public", class: "font-bold text-gray-900 dark:text-gray-100 cursor-pointer" %>
      <p class="text-gray-500 dark:text-gray-400">
        Si activé, l'album apparaîtra dans votre galerie publique. Le nom du client sera masqué pour protéger sa vie privée.
      </p>
    </div>
  </div>

  <% if @clients.empty? %>
    <p class="text-red-500 text-sm mb-2">Aucun client disponible, ajoutez un client avant de créer un album.</p>
  <% end %>

  <div class="flex flex-col gap-2 items-center justify-end">
    <%= form.button type: "submit",
        class: "btn btn-primary justify-center hover:text-blue-600 items-center flex w-full bottom-7 text-white p-2 rounded-full shadow-md transition duration-300 ease-in-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100",
        disabled: @clients.empty? do %>
        Valider
    <% end %>

    <%= link_to 'Ajouter un client', new_client_path, class: "text-primary font-bold hover:underline" %>
  </div>
<% end %>

