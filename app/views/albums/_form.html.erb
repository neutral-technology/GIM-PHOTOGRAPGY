<%= form_with(model: album, class: "gap-3 items-center align-center w-full space-y-5", html: { 'x-data': 'submitOnEnter', 'x-ref': 'form' }) do |form| %>
  <% if album.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
      <h2 class="font-bold">Error!</h2>
      <ul>
        <% album.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label "Nom de l'album", class: "block text-white-dark" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <div>
    <%= form.label 'Mot de passe ', class: "block text-white-dark" %>
    <%= form.password_field :password, class: "form-input" %>
    <p class="mt-2 text-sm text-gray-500">Ajouter ou laisser vide pour un mot de passe automatique</p>
  </div>
  <div>
    <%= form.label :client_id, "Assigner un client", class: "block text-white-dark" %>
    <%= form.select :client_id, options_for_select(@clients.map { |c| [c.name, c.id] }), { include_blank: 'Selectioner un client' }, class: "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="flex flex-col gap-2 items-center justify-end">
    <%= form.button type: "submit",
        class: " btn btn-primary justify-center hover:text-blue-600 items-center  flex w-full bottom-7 text-white p-2 rounded-full shadow-md transition duration-300 ease-in-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100" do %>
        Valider
    <% end %>
    <%= link_to 'Ajouter un client', new_client_path, class: "text-primary font-bold hover:underline" %>
  </div>
<% end %>