<div
  x-data="{ open: false }"
  x-on:open-brochure-modal.window="open = true"
  x-show="open"
  x-cloak
  class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
>
  <div class="bg-white dark:bg-[#1b2e4b] rounded-xl p-6 w-full max-w-md">
    <h3 class="font-semibold text-lg mb-4">
      Create Brochure
    </h3>

    <%= form_with model: @new_brochure do |f| %>

      <div class="mb-3">
        <%= f.label :title, class: "block text-white-dark" %>
        <%= f.text_field :title,
              class: "form-input w-full",
              placeholder: "Wedding of John & Sarah" %>
      </div>

      <div class="mb-4">
        <%= f.label :brochure_preset_id, "Template", class: "block text-white-dark" %>
        <%= f.select :brochure_preset_id,
              options_for_select(@brochure_presets.map { |c| [c.name, c.id] }),
              { include_blank: 'Choisir une template' },
              class: "form-select w-full" %>
      </div>

      <div>
        <%= f.label :client_id, "Pour quel client", class: "block text-white-dark" %>
        <%= f.select :client_id,
              options_for_select(@clients.map { |c| [c.name, c.id] }),
              { include_blank: 'Choisir le client' },
              class: "form-input mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="flex justify-end gap-2">
        <button type="button"
                @click="open = false"
                class="btn btn-outline">
          Cancel
        </button>
        <%= f.submit "Create", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
