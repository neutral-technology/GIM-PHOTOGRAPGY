<div
  x-data="{
    open: false,
    kind: 'brochure',
    presets: <%= @brochure_presets.map { |p|
      {
        id: p.id,
        name: p.name,
        display_name: p.display_name
      }
    }.to_json %>,
    
    get filteredPresets() {
      return this.presets.filter(p => {
        if (this.kind === 'invitation') {
          return p.name.startsWith('invitation')
        }

        return !p.name.startsWith('invitation')
      })
    }
  }"
  x-on:open-brochure-modal.window="
    open = true;
    window.scrollTo({ top: 0, behavior: 'instant' });
    document.body.classList.add('overflow-hidden')
  "
  x-show="open"
  x-cloak
  @click.self="
    open = false;
    document.body.classList.remove('overflow-hidden');
    setTimeout(() => {
      window.scrollTo({
        top: document.documentElement.scrollHeight,
        behavior: 'smooth'
      });
    },50);
  "
  class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto"
>
  <div class="w-full max-w-[480px] my-8">
    <div class="panel rounded-xl p-6 shadow-2xl">
      <h3 class="font-bold text-xl mb-6 text-gray-800 dark:text-white">
        Créer une Brochure
      </h3>

      <%= form_with model: @new_brochure do |f| %>
        <%# --- Title --- %>
        <div class="mb-4">
          <%= f.label :title, "Nom du projet", class: "block text-sm font-medium mb-1" %>
          <%= f.text_field :title,
                class: "form-input w-full rounded-lg border-gray-300 dark:bg-[#121e32]",
                placeholder: "Ex: Mariage de Marc & Sophie" %>
        </div>

        <div class="mb-4">
          <%= f.label :kind,
              "Type",
              class:"block text-sm font-medium mb-1" %>

          <%= f.select :kind,
              [
                ["📖 Brochure", "brochure"],
                ["💌 Invitation électronique", "invitation"]
              ],
              {},
              {
                class:"form-select w-full rounded-lg border-gray-300",
                "x-model":"kind"
              }
          %>

        </div>

        <%# --- Template Selection (Tiers) --- %>
        <div class="mb-4">

          <%= f.label :brochure_preset_id,
              "Design",
              class:"block text-sm font-medium mb-1" %>
          <select
            name="brochure[brochure_preset_id]"
            class="form-select w-full rounded-lg border-gray-300 dark:bg-[#121e32]"
          >
            <option value="">Choisir un design</option>
            <template x-for="preset in filteredPresets"
                      :key="preset.id">
              <option
                :value="preset.id"
                x-text="preset.display_name">
              </option>
            </template>
          </select>
        </div>

        <%# --- Client Selection --- %>
        <div class="mb-8">
          <%= f.label :client_id, "Client associé", class: "block text-sm font-medium mb-1" %>
          <%= f.select :client_id,
                options_for_select(@clients.map { |c| [c.name, c.id] }),
                { include_blank: 'Choisir le client' },
                class: "form-select w-full rounded-lg border-gray-300 dark:bg-[#121e32]" %>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-gray-100 dark:border-gray-700">
          <button type="button"
                  @click="open = false; document.body.classList.remove('overflow-hidden')"
                  class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 transition">
            Annuler
          </button>
          <%= f.submit "Générer", 
              class: "bg-primary text-white px-6 py-2 rounded-lg font-bold hover:bg-primary/90 transition shadow-lg shadow-primary/20" %>
        </div>
      <% end %>
    </div>
  </div>
</div>