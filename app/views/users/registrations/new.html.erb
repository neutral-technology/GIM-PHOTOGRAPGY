<%# app/views/users/registrations/new.html.erb %>

<div class=" mb-8 flex justify-center items-center min-h-screen bg-cover bg-center">
    <div class="panel sm:w-[480px] my-6 max-w-lg w-full" x-data="{ submitting: false }">
        <h2 class="font-bold text-2xl mb-3">Créer un compte</h2>
        <p class="mb-7">Entrez vos donnés pour vous enrégistrer</p>

        <%# Devise Error Messages %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }, html: { class: "space-y-5", x_on: { submit: "submitting = true" } }) do |f| %>

            <%# Full Name Field %>
            <div>
                <%= f.label "Votre nom", class: "block text-white-dark" %>
                <%= f.text_field :full_name, autofocus: true, class: "form-input font-normal", placeholder: "Nom complet" %>
            </div>

            <%# Email Field %>
            <div>
                <%= f.label "Adresse e-mail", class: "block text-white-dark" %>
                <%= f.email_field :email, autocomplete: "email", class: "form-input font-normal", placeholder: "Adresse e-mail" %>
            </div>

            <%# Password Field %>
            <div>
                <%= f.label "Mot de passe", class: "block text-white-dark" %>
                <%= f.password_field :password, autocomplete: "new-password", class: "form-input font-normal", placeholder: "**************" %>
                <% if @minimum_password_length %>
                    <small class="text-white-dark mt-1 block">
                        (<%= @minimum_password_length %> charactères minimum)
                    </small>
                <% end %>
            </div>

            <%# Password Confirmation Field (REQUIRED by Devise for registration) %>
            <div>
                <%= f.label "Confirmer votre mot de passe", class: "block text-white-dark" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input font-normal", placeholder: "**************" %>
            </div>

            <%# City Field %>
            <div>
                <%= f.label "Ville de résidence", class: "block text-white-dark" %>
                <%= f.text_field :city, class: "form-input font-normal", placeholder: "ville" %>
            </div>

            <%# Terms and Conditions Checkbox %>
            <div>
                <label class="cursor-pointer flex items-center">
                    <input type="checkbox" class="form-checkbox" required /> <%# Added 'required' for basic validation %>
                    <span for="custom_checkbox" class="text-white-dark ml-2">J'accepte les <a href="javascript:;" class="text-primary hover:underline">Termes et Conditions</a></span>
                </label>
            </div>

            <button type="submit"
                class="btn btn-primary w-full flex items-center justify-center"
                x-bind:disabled="submitting"
            >
                <span x-show="!submitting">CRÉER LE COMPTE</span>
                <span x-show="submitting" class="flex items-center">
                    En cours...
                    <span class="loader ml-2"></span>
                </span>
            </button>
        <% end %>

        <div class="relative my-7 h-5 text-center before:w-full before:h-[1px] before:absolute before:inset-0 before:m-auto before:bg-[#ebedf2] dark:before:bg-[#253b5c]">
            <div class="font-bold text-white-dark bg-white dark:bg-[#0e1726] px-2 relative z-[1] inline-block"><span>OU</span></div>
        </div>
        <p class="text-center"><%= link_to "Se connecter", new_user_session_path, class: "text-primary font-bold hover:underline" %> si vous avez un compte</p>
    </div>
</div>

