<script defer src="/assets/js/apexcharts.js"></script>

<div class="mt-20" x-data="{search: '' }">
    <div class="fle bg-white py-6 px-4 w-full justify-between">
        <ul class="flex rtl:space-x-reverse w-full">
            <li>
                <a href="javascript:;" class="text-primary hover:underline">Studio connect</a>
            </li>
            <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
                <span>Profile</span>
            </li>
            <li>
                <a href="/users/user-account-settings" class= "before:content-['/'] text-primary hover:underline">
                    <span>Modifier votre profile</span>
                </a>
            </li>
        </ul>
        <div class="bg-white mt-4 wfull">
            <div class="flex gap-2 items-center">
                <input
                    x-model="search"
                    type="text"
                    placeholder="Rechercher : client, album, numéro du reçu..."
                    class="form-input w-ful pl-10"
                />
                <button
                    type="button"
                    @click="search = ''"
                    :class="search ? ' pointer-events-auto' : ' pointer-events-none'"
                    class="  transition text-gray-600 border hover:text-danger p-2 rounded bg-danger-light"
                >
                    effacer
                </button>
            </div>
                <p class="text-sm text-gray-500 mt-2">
                    Recherche intelligente par client, album ou numéro du reçu.
                </p>
        </div>
    </div>
    <div class="mb-2">
        <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            <%# recete section %>
            <div x-data="{tab: 'home'}">
                <ul class="flex justify-between bg-white font-semibold border-b border-[#ebedf2] dark:border-[#191e3a] mb-1 whitespace-nowrap overflow-y-auto">
                    <li class="inline-block">
                        <a href="javascript:;" class="flex gap-2 p-4 border-b border-transparent hover:border-primary hover:text-primary" :class="{'!border-primary text-primary' : tab == 'home'}" @click="tab='home'">
                            🌀 Factures
                        </a>
                    </li>
                    <li class="inline-block">
                        <a href="javascript:;" class="flex gap-2 p-4 border-b border-transparent hover:border-primary hover:text-primary" :class="{'!border-primary text-primary' : tab == 'preferences'}" @click="tab='preferences'">
                            ⭕️ Dépenses
                        </a>
                    </li>
                    <li class="inline-block">
                        <a href="javascript:;" class="flex gap-2 p-4 border-b border-transparent hover:border-primary hover:text-primary" :class="{'!border-primary text-primary' : tab == 'danger-zone'}" @click="tab='danger-zone'">
                            📊 Rapports
                        </a>
                    </li>
                </ul>
                <template x-if="tab === 'home'">
                    <div class="grid g gap-5">
                        <div class="panel ">
                            <div class="w-full">
                                <h5 class="mb-4 font-semibold text-lg dark:text-white-light">Filters par categorie</h5>
                                <div class="my-4 flex justify-between">
                                    <%= link_to "Tout voir", users_profile_path, class: "btn btn-sm" %>
                                    <%= link_to "Cette semaine", users_profile_path(filter: "week"), class: "btn btn-sm" %>
                                    <%= link_to "Ce mois", users_profile_path(filter: "month"), class: "btn btn-sm" %>
                                </div>  
                            </div>
                            <div class="mb-5 flex justify-between items-center">
                                <h5 class="font-semibold text-lg dark:text-white-light">Factures</h5>
                                <ul class="flex items-center">
                                    <li>
                                        <%= link_to "✚ facture", new_receipt_path, class: "btn btn-primary hover:underline" %>
                                    </li>
                                </ul>
                            </div>
                            <div class="space-y-4 overflow-y-auto" style="height: 700px; background-color: #f1eeee50;">
                                <% if @receipts.present?%>
                                    <% @receipts&.sort_by { |r| -r.created_at.to_i }&.each do |receipt| %>
                                        <%= render "receipts/receipt_card", receipt: receipt %>
                                    <% end %>
                                <% else %>
                                    <div class="h-full items-center space-y-4 flex justify-center bg-white">
                                        <p class="text-center flex text-5xl">🛒</p>
                                    </div>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </template>
                <template x-if="tab === 'preferences'">
                    <div class="switch">
                        <div class="panel ">
                            <div class="mb-5 flex justify-between items-center">
                                <h5 class="font-semibold text-lg dark:text-white-light">Dépenses</h5>
                                <ul class="flex items-center">
                                    <li>
                                        <%= link_to "✚ dépense", new_expense_path, class: "btn btn-primary hover:underline" %>
                                    </li>
                                </ul>
                            </div>
                            <div class="space-y-3 overflow-y-auto" style="height: 500px; background-color: #f1eeee50;">
                                <% if @expenses.present? %>
                                    <% @expenses.each do |expense| %>
                                    <%= render "expenses/expense_card", expense: expense %>
                                    <% end %>
                                <% else %>
                                    <div class="h-full items-center space-y-4 flex justify-center bg-white">
                                        <p class="text-center flex text-5xl">🛒</p>
                                    </div>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </template>
                <template x-if="tab === 'danger-zone'">
                    <div class="switch">
                        <div class="panel ">
                            <div class="w-full">
                                <h5 class="mb-4 font-semibold text-lg dark:text-white-light">Filtre mensuel</h5>
                                <form method="get" class="flex flex-col gap-3 items-center mb-4">
                                    <div class="flex gap-2 w-full">
                                        <select name="month" class="form-select">
                                            <% 1.upto(12) do |m| %>
                                            <option value="<%= m %>" <%= "selected" if m == (params[:month] || Date.current.month).to_i %>>
                                                <%= Date::MONTHNAMES[m] %>
                                            </option>
                                            <% end %>
                                        </select>

                                        <select name="year" class="form-select">
                                            <% (Date.current.year - 2..Date.current.year).each do |y| %>
                                            <option value="<%= y %>" <%= "selected" if y == (params[:year] || Date.current.year).to_i %>>
                                                <%= y %>
                                            </option>
                                            <% end %>
                                        </select>
                                    </div>

                                    <button class="btn bottom-0 mt-2 w-full btn-primary h-10">
                                        Aficher le rapport
                                    </button>
                                </form>
                            </div>
                            <%= render "reports/monthly_report_card" %>
                        </div>
                    </div>
                </template>
            </div>
            <%# albums %>
            <div class="panel border lg:col-span-2 xl:col-span-3">
                <div class="mb-5 flex gap-2 justify-between items-center">
                    <h5 class="font-semibold text-lg dark:text-white-light">Albums</h5>
                    <ul class="flex items-center gap-3 ">
                        <li>
                            <a href="/albums/new" class="justify-center flex items-center btn btn-primary hover:underline">✚ album</a>
                        </li>
                        <li class="">
                            <a href="/clients/new" class=" hover:underline btn btn-primary">✚ client</a>
                        </li>
                    </ul>
                </div>
                <div class="overflow-y-auto" style="max-height: 800px">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                        <% @albums.each do |album| %>
                            <%= render "albums/album_card", album: album %>
                        <% end %>
                    </div>
                </div>


            </div>
        </div>
    </div>
    <div class="mb-3 gap-3 flex justify-between grid grid-cols-1 lg:grid-cols-2">
        <div class="panel w-full">
            <%# tarif section %>
            <div class="mb-5 flex justify-between items-center">
                <h5 class="font-semibold text-lg dark:text-white-light">Tarifs</h5>
                <ul class="flex items-center">
                    <li>
                        <%= link_to "✚ tarif", new_tarif_path, class: "btn btn-primary hover:underline" %>
                    </li>
                </ul>
            </div>
            <div class="flex gap-2 overflow-x-auto px-4 pb-2 scroll-px-4" style="background-color: #f1eeee50;">
                <% @tarifs.each do |tarif| %>
                    <%= render "tarifs/tarif_card", tarif: tarif, show_actions: true %>
                <% end %>
            </div>
        </div>
        <div class="panel w-full">
            <div class="flex items-center justify-between mb-2">
                <h5 class="font-semibold text-lg dark:text-white-light">Fidélité</h5>
                <p class="text-sm text-gray-600">
                    Seuil VIP :
                    <strong>
                        <%= number_with_delimiter(current_user.vip_threshold) %> FC
                        (<%= current_user.vip_threshold / 100 %> pts)
                    </strong>
                </p>
            </div>
            <div class= "mb-6">
                <!-- Header -->
                <div class="flex justify-between items-center mb-4">
                    <h5 class="font-semibold text-lg dark:text-white-light">
                    Clients VIP
                    </h5>
                    <span class="text-xs text-gray-500">
                    <%= @vip_clients.count %> client(s)
                    </span>
                </div>

                <% if @vip_clients.any? %>
                    <div class="overflow-y-auto" style="height: 150px;">
                    <table class="w-full text-sm">
                        <thead>
                        <tr class="text-left text-gray-500 border-b">
                            <th class="py-2">Client</th>
                            <th>Points</th>
                            <th>Dépenses</th>
                            <th>Photos</th>
                            <th></th>
                        </tr>
                        </thead>

                        <tbody class="overflow-x-auto">
                            <% @vip_clients.each do |client| %>
                                <tr class="border-b hover:bg-info-light dark:hover:bg-gray-800">
                                <!-- Client -->
                                <td class="py-3 font-medium">
                                    <span class="flex items-center gap-2">
                                    ⭐ <%= client.name %>
                                    </span>
                                    </td>

                                    <!-- Points -->
                                    <td>
                                        <strong>
                                            <% if client.fidelity_points.to_i > 1000 %>
                                                1000
                                            <% else %>
                                                <%= client.fidelity_points %>
                                            <% end %>

                                        </strong> pts
                                    </td>

                                    <!-- Money -->
                                    <td>
                                        <%= number_with_delimiter(client.total_spent_fc) %> FC
                                    </td>

                                    <!-- Photos -->
                                    <td>
                                        <%= client.total_photos || 0 %>
                                    </td>
                                    <td>
                                        <% if client.vip? %>
                                            <a href="<%= whatsapp_vip_link(client, current_user) %>" target="_blank" class="text-white px-1 rounded bg-success">
                                                whatsapp
                                            </a>
                                        <% end %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                    </div>

                <% else %>
                    <div class="text-sm text-gray-500 text-center py-6">
                    Aucun client n’a encore atteint le seuil VIP.
                    </div>
                <% end %>

                <!-- Footer -->
                <div class="mt-4 text-xs text-gray-400">
                    Les clients VIP bénéficient d’avantages exclusifs, cadeaux et priorités sur les offres spéciales.
                </div>

                </div>

        </div>
    </div>
    <div class="mb-16">
        <%= render "users/profile/brochures" %>
    </div>
</div>

