<script defer src="/assets/js/apexcharts.js"></script>

<div>
    <ul class="flex space-x-2 rtl:space-x-reverse bg-white py-6">
        <li>
            <a href="javascript:;" class="text-primary hover:underline">Studio connect</a>
        </li>
        <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
            <span>Profile</span>
        </li>
        <li>
            <a href="/users/user-account-settings" class= "before:content-['/'] text-primary hover:underline">
                <span>Modifier votre profile</span>
            </a>
        </li>
    </ul>
    <div class="mb-2">
        <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            <%# recete section %>
            <div x-data="{tab: 'home'}">
                <ul class="flex justify-between bg-white font-semibold border-b border-[#ebedf2] dark:border-[#191e3a] mb-1 whitespace-nowrap overflow-y-auto">
                    <li class="inline-block">
                        <a href="javascript:;" class="flex gap-2 p-4 border-b border-transparent hover:border-primary hover:text-primary" :class="{'!border-primary text-primary' : tab == 'home'}" @click="tab='home'">
                            🌀 Recèttes
                        </a>
                    </li>
                    <li class="inline-block">
                        <a href="javascript:;" class="flex gap-2 p-4 border-b border-transparent hover:border-primary hover:text-primary" :class="{'!border-primary text-primary' : tab == 'preferences'}" @click="tab='preferences'">
                            ⭕️ Dépenses
                        </a>
                    </li>
                    <li class="inline-block">
                        <a href="javascript:;" class="flex gap-2 p-4 border-b border-transparent hover:border-primary hover:text-primary" :class="{'!border-primary text-primary' : tab == 'danger-zone'}" @click="tab='danger-zone'">
                            📊 Rapports
                        </a>
                    </li>
                </ul>
                <template x-if="tab === 'home'">
                    <div class="grid g gap-5">
                        <div class="panel ">
                            <div class="w-full">
                                <h5 class="mb-4 font-semibold text-lg dark:text-white-light">Filters par categorie</h5>
                                <div class="my-4 flex justify-between">
                                    <%= link_to "Par default", users_profile_path, class: "btn btn-sm" %>
                                    <%= link_to "Cette semaine", users_profile_path(filter: "week"), class: "btn btn-sm" %>
                                    <%= link_to "Ce mois", users_profile_path(filter: "month"), class: "btn btn-sm" %>
                                </div>

                                <%= form_with url: users_profile_path, method: :get, local: true, class: "mb-4 flex gap-2 flex-wrap justify-between" do %>
                                    <div class="w-20">
                                        <label>Par Jour</label>
                                        <%= date_field_tag :day, params[:day], class: "w-full"%>
                                    </div>

                                    <div class="w-20">
                                        <label>Par Mois</label>
                                        <%= select_tag :month, options_for_select((1..12).map { |m| [Date::MONTHNAMES[m], m] }, params[:month]), class: "w-full" %>
                                    </div>

                                    <div class="w-20">
                                        <label>Par An</label>
                                        <%= number_field_tag :year, params[:year] || Date.current.year, min: 2000, max: Date.current.year, class: "w-full" %>
                                    </div>
                                    <div class="w-full">
                                        <%= submit_tag "Filtrer la recherche", class: "btn bottom-0 mt-6 w-full btn-primary h-10" %>
                                    </div>
                                <% end %>
                            </div>
                            <div class="mb-5 flex justify-between items-center">
                                <h5 class="font-semibold text-lg dark:text-white-light">Recèttes</h5>
                                <ul class="flex items-center">
                                    <li>
                                        <%= link_to "✚ recètte", new_receipt_path, class: "btn btn-primary hover:underline" %>
                                    </li>
                                </ul>
                            </div>
                            <div class="space-y-4 overflow-y-auto" style="height: 500px; background-color: #f1eeee50;">
                                <% if @receipts.present?%>
                                    <% @receipts&.sort_by { |r| -r.created_at.to_i }&.each do |receipt| %>

                                        <div class="receipt-card border rounded-xl bg-white dark:bg-[#1b2e4b] dark:border-0 p-4 shadow">
                                            <!-- HEADER : LOGO + STUDIO INFO -->
                                            <div class="flex items-center justify-between mb-6 border-b pb-4">
                                                <div class="flex-shrink-0 main-logo flex items-center justify-center bg-black w-20 h-20 rounded">
                                                    <%= image_tag "/GIM2.png", alt: "Studio Logo", class: "w-20 border-t border-b h-auto object-contain" %>
                                                </div>
                                                <div class="text-sm text-right">
                                                <h2 class="font-bold text-lg text-gray-800 dark:text-white"><%= current_user.full_name.upcase %> PHOTOGRAPHY</h2>
                                                <p class="text-gray-600 dark:text-gray-300">Adresse: <%= current_user.city || 'Av ... Q...' %></p>
                                                <p class="text-gray-600 dark:text-gray-300">Tél : +243 812 000 000</p>
                                                <p class="text-gray-600 dark:text-gray-300">Email: <%= current_user.email %></p>
                                                </div>
                                            </div>

                                            <!-- TITLE + AMOUNT -->
                                            <div class="flex justify-between">
                                                <h6 class="font-semibold text-gray-700 dark:text-white">
                                                    Photo: <%= receipt.shooting_type.titleize %>
                                                </h6>
                                                <span class="font-semibold text-gray-700 dark:text-white">
                                                    Prix: <%= receipt.amount %> <%= receipt.currency.upcase %>
                                                </span>
                                            </div>

                                            <!-- SUB DETAILS -->
                                            <div class="flex justify-between mt-1 text-xs text-gray-600 dark:text-gray-300">
                                                <span>nombre des photos: <%= receipt.photos_count %></span>
                                                <span>Date: <%= receipt.date.strftime("%d/%m/%Y") %></span>
                                            </div>

                                            <!-- PAYMENT DETAILS -->
                                            <div class="mt-2 text-xs">
                                                <p class="text-gray-700 dark:text-gray-200">
                                                    <strong>Montant payé:</strong>
                                                    <%= receipt.amount_paid %> <%= receipt.paid_currency.upcase %>
                                                </p>

                                                <% if receipt.balance > 0 %>
                                                    <p class="text-red-600 tr font-bold text-danger">
                                                        Reste : <%= receipt.balance.round(2) %> <%= receipt.currency.upcase %>
                                                        <% if receipt.currency != receipt.paid_currency %>
                                                        (<%= receipt.balance_in_paid_currency.round(2) %> <%= receipt.paid_currency.upcase %>)
                                                        <% end %>
                                                    </p>
                                                <% elsif receipt.balance < 0 %>
                                                <p class="text-yellow-500 font-bold text-warning">
                                                    Excédant : <%= receipt.balance.abs.round(2) %> <%= receipt.currency.upcase %>
                                                </p>

                                                <% else %>
                                                <p class="font-bold text-success">
                                                    Payement complet 
                                                </p>
                                                <% end %>
                                                
                                                <p class="text-xs text-gray-600 pt-2">
                                                    Points gagnés :
                                                        <% if receipt.fidelity_points.to_i > receipt.client.vip_threshold_points.to_i %>
                                                            1000 / <%= receipt.client.vip_threshold_points %>
                                                        <% else %>
                                                            <%= receipt.fidelity_points %> / <%= receipt.client.vip_threshold_points %>
                                                        <% end %>
                                                </p>
                                            </div>

                                            <!-- ALBUM LINK (HIDDEN IN PRINT) -->
                                            <div class="mt-3 no-print">
                                                <%= link_to "Voir l’album →", album_path(receipt.album),
                                                    class: "text-primary text-xs font-bold hover:underline" %>
                                                <span>client: <strong><%= receipt.client.name %></strong></span>
                                                <%= render "shared/vip_badge" if receipt.client.vip? %>

                                            </div>
                                            <!-- FOOTER NOTE -->
                                            <div class="text-xs text-gray-500 dark:text-gray-300 mt-2">
                                                <p>Merci pour votre confiance!</p>
                                                <p>Cette facture est générée automatiquement par le studio <%= current_user.full_name.upcase %> PHOTOGRAPHY.</p>
                                                <span>Le: <%= receipt.created_at.strftime("%d/%m/%Y à %H:%M") %></span>
                                                <div class="text-xs text-gray-500 dark:text-gray-300 mb-2">
                                                    <strong>Numéro de série:</strong> <%= receipt.serial_code %>
                                                </div>
                                            </div>
                                        </div>
                                    <% end %>
                                <% else %>
                                    <div class="h-full items-center space-y-4 flex justify-center bg-white">
                                        <p class="text-center flex text-5xl">🛒</p>
                                    </div>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </template>
                <template x-if="tab === 'preferences'">
                    <div class="switch">
                        <div class="panel ">
                            <div class="mb-5 flex justify-between items-center">
                                <h5 class="font-semibold text-lg dark:text-white-light">Dépenses</h5>
                                <ul class="flex items-center">
                                    <li>
                                        <%= link_to "✚ dépense", new_expense_path, class: "btn btn-primary hover:underline" %>
                                    </li>
                                </ul>
                            </div>
                            <div class="space-y-3 overflow-y-auto" style="height: 500px; background-color: #f1eeee50;">
                                <% if @expenses.present? %>
                                    <% @expenses.each do |expense| %>
                                    <%= render "expenses/expense_card", expense: expense %>
                                    <% end %>
                                <% else %>
                                    <div class="h-full items-center space-y-4 flex justify-center bg-white">
                                        <p class="text-center flex text-5xl">🛒</p>
                                    </div>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </template>
                <template x-if="tab === 'danger-zone'">
                    <div class="switch">
                        <div class="panel ">
                            <div class="w-full">
                                <h5 class="mb-4 font-semibold text-lg dark:text-white-light">Filtre mensuel</h5>
                                <form method="get" class="flex flex-col gap-3 items-center mb-4">
                                    <div class="flex gap-2 w-full">
                                        <select name="month" class="form-select">
                                            <% 1.upto(12) do |m| %>
                                            <option value="<%= m %>" <%= "selected" if m == (params[:month] || Date.current.month).to_i %>>
                                                <%= Date::MONTHNAMES[m] %>
                                            </option>
                                            <% end %>
                                        </select>

                                        <select name="year" class="form-select">
                                            <% (Date.current.year - 2..Date.current.year).each do |y| %>
                                            <option value="<%= y %>" <%= "selected" if y == (params[:year] || Date.current.year).to_i %>>
                                                <%= y %>
                                            </option>
                                            <% end %>
                                        </select>
                                    </div>

                                    <button class="btn bottom-0 mt-2 w-full btn-primary h-10">
                                        Aficher le rapport
                                    </button>
                                </form>
                            </div>
                            <%= render "reports/monthly_report_card" %>
                        </div>
                    </div>
                </template>
            </div>
            <%# albums %>
            <div class="panel lg:col-span-2 xl:col-span-3">
                <div class="mb-5 flex gap-2 justify-between items-center">
                    <h5 class="font-semibold text-lg dark:text-white-light">Albums</h5>
                    <ul class="flex items-center gap-3 ">
                        <li>
                            <a href="/albums/new" class="justify-center flex items-center btn btn-primary hover:underline">✚ album</a>
                        </li>
                        <li class="">
                            <a href="/clients/new" class=" hover:underline btn btn-primary">✚ client</a>
                        </li>
                    </ul>
                </div>
                <div class="mb-5 overflow-y-auto" style="max-height: 783px">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                        <% @albums&.each do |album| %>
                            <%= link_to album, class: "block transition-transform duration-300 hover:scale-105" do %>
                            <div class="relative bg-gray-800 border rounded-xl shadow-lg overflow-hidden group" style="background-color: #efeff572;">
                                <div class="w-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center" style="height: 140px;">
                                    <% if album.cover_photo.attached? %>
                                        <%= image_tag album.cover_photo, class: "w-full h-full object-cover" %>
                                    <% else %>
                                        <div class="text-gray-400 dark:text-gray-500 text-6xl">📸</div>
                                    <% end %>
                                </div>
                                <div class="py-3 text-center">
                                    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2"><%= album.name %></h3>
                                    <p class="text-gray-600 dark:text-gray-400 font-medium">Client: <%= album.client.name %></p>
                                    <p class="text-gray-600 dark:text-gray-400 font-medium">Nombre de photos: <%= album.images.count %></p>
                                </div>
                            </div>
                            <% end %>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-16 gap-3 flex justify-between grid grid-cols-1 lg:grid-cols-2">
        <div class="panel w-full">
            <%# tarif section %>
            <div class="mb-5 flex justify-between items-center">
                <h5 class="font-semibold text-lg dark:text-white-light">Tarifs</h5>
                <ul class="flex items-center">
                    <li>
                        <%= link_to "✚ tarif", new_tarif_path, class: "btn btn-primary hover:underline" %>
                    </li>
                </ul>
            </div>
            <div class="flex gap-2 overflow-x-auto px-4 pb-2 scroll-px-4" style="background-color: #f1eeee50;">
                <% @tarifs.each do |tarif| %>
                    <%= render "tarifs/tarif_card", tarif: tarif, show_actions: true %>
                <% end %>
            </div>
        </div>
        <div class="panel w-full">
            <div class="flex items-center justify-between mb-2">
                <h5 class="font-semibold text-lg dark:text-white-light">Fidélité</h5>
                <p class="text-sm text-gray-600">
                    Seuil VIP :
                    <strong>
                        <%= number_with_delimiter(current_user.vip_threshold) %> FC
                        (<%= current_user.vip_threshold / 100 %> pts)
                    </strong>
                </p>
            </div>
            <div class= "mb-6">
                <!-- Header -->
                <div class="flex justify-between items-center mb-4">
                    <h5 class="font-semibold text-lg dark:text-white-light">
                    Clients VIP
                    </h5>
                    <span class="text-xs text-gray-500">
                    <%= @vip_clients.count %> client(s)
                    </span>
                </div>

                <% if @vip_clients.any? %>
                    <div class="overflow-y-auto" style="height: 150px;">
                    <table class="w-full text-sm">
                        <thead>
                        <tr class="text-left text-gray-500 border-b">
                            <th class="py-2">Client</th>
                            <th>Points</th>
                            <th>Dépenses</th>
                            <th>Photos</th>
                            <th></th>
                        </tr>
                        </thead>

                        <tbody class="overflow-x-auto">
                            <% @vip_clients.each do |client| %>
                                <tr class="border-b hover:bg-info-light dark:hover:bg-gray-800">
                                <!-- Client -->
                                <td class="py-3 font-medium">
                                    <span class="flex items-center gap-2">
                                    ⭐ <%= client.name %>
                                    </span>
                                    </td>

                                    <!-- Points -->
                                    <td>
                                        <strong>
                                            <% if client.fidelity_points.to_i > 1000 %>
                                                1000
                                            <% else %>
                                                <%= client.fidelity_points %>
                                            <% end %>

                                        </strong> pts
                                    </td>

                                    <!-- Money -->
                                    <td>
                                        <%= number_with_delimiter(client.total_spent_fc) %> FC
                                    </td>

                                    <!-- Photos -->
                                    <td>
                                        <%= client.total_photos || 0 %>
                                    </td>
                                    <td>
                                        <% if client.vip? %>
                                            <a href="<%= whatsapp_vip_link(client, current_user) %>" target="_blank" class="text-white px-1 rounded bg-success">
                                                whatsapp
                                            </a>
                                        <% end %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                    </div>

                <% else %>
                    <div class="text-sm text-gray-500 text-center py-6">
                    Aucun client n’a encore atteint le seuil VIP.
                    </div>
                <% end %>

                <!-- Footer -->
                <div class="mt-4 text-xs text-gray-400">
                    Les clients VIP bénéficient d’avantages exclusifs, cadeaux et priorités sur les offres spéciales.
                </div>

                </div>

        </div>
    </div>
</div>

