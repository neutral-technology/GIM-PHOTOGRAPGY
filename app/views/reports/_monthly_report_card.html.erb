<div class="panel border mb-8">

  <!-- ================= HEADER ================= -->
  <div class="border-b pb-4 mb-6 flex flex-col justify-between items-start">
    <div class="">
      <h4 class="text-md flex justify-center text-center font-bold text-gray-800">
        📊 Rapport financier mensuel du <%= params[:month].present? ?
          Date::MONTHNAMES[params[:month].to_i] :
          Date.current.strftime("%B") %>
        <%= params[:year] || Date.current.year %>
      </h4>
    </div>
      <div class="flex w-full items-center mt-1 justify-between">
        <p class="text-xs text-gray-500">
          Studio <strong><%= current_user.full_name %></strong>
        </p>
        <p class="text-xs text-gray-400">
          Généré le <%= Time.current.strftime("%d/%m/%Y à %H:%M") %>
        </p>
      </div>
  </div>

  <!-- ================= INTRO TEXT ================= -->
  <div class="mb-6 text-sm text-gray-600 leading-relaxed">
    <p>
      Ce rapport présente un résumé financier des activités du studio pour le mois de
      <strong>
        <%= params[:month].present? ?
          Date::MONTHNAMES[params[:month].to_i] :
          Date.current.strftime("%B") %>
        <%= params[:year] || Date.current.year %>
      </strong>.
    </p>
    <p class="mt-2">
      Il inclut l’ensemble des <strong>recettes encaissées</strong>, des
      <strong>dépenses engagées</strong>, ainsi que des
      <strong>montants remboursés ou annulés</strong>, afin de fournir une vision claire
      et fidèle de la performance financière du studio.
    </p>
  </div>

  <!-- ================= METRICS ================= -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2 mb-6">

    <!-- INCOME -->
    <div class="p-4 rounded bg-success-light border">
      <p class="text-sm text-gray-600">Recettes</p>
      <p class="text-lg font-bold text-green-700 pt-4">
        <%= number_to_currency(@total_income) %>
      </p>
    </div>

    <!-- EXPENSE -->
    <div class="p-4 rounded bg-danger-light border">
      <p class="text-sm text-gray-600">Dépenses</p>
      <p class="text-lg font-bold text-red-700 pt-3">
        - <%= number_to_currency(@total_expense) %>
      </p>
    </div>

    <!-- REFUNDS -->
    <div class="p-4 rounded bg-warning-light border">
      <p class="text-sm text-gray-600">Remboursés</p>
      <p class="text-lg font-bold text-yellow-700 pt-3">
        + <%= number_to_currency(@total_refund) %>
      </p>
    </div>

    <!-- RESULT -->
    <div class="p-4 rounded border
      <%= @net_result > 0 ? 'bg-primary-light' : 'bg-danger-light' %>">
      <p class="text-sm text-gray-600">Résultat net</p>
      <p class="text-lg font-bold pt-3
        <%= @net_result > 0 ? 'text-primary' : 'text-danger' %>">
        <%= number_to_currency(@net_result) %>
      </p>
    </div>

  </div>

  <!-- ================= FOOTER ================= -->
  <div class="border-t pt-4 text-left text-xs flex-col text-gray-500 flex items-center">
    <p>
      Rapport généré automatiquement par le système de gestion du studio.
    </p>
    <p class="italic w-full mt-2">
      Usage interne – données confidentielles
    </p>
  </div>

</div>
