<section class="min-h-screen py-20 px-6 md:px-20" style="background-color: var(--bg);">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-16">
      <span class="uppercase tracking-[0.3em] text-xs mb-4 mt-8 bloc" style="color: var(--primary);">Là où tout a commencé</span>
      <h2 class="text-5xl font-serif" style="color: var(--text); font-family: var(--font-main);">Notre Histoire</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="space-y-8 blocks sortable" data-controller="sortable editor">
        <% page.blocks.order(:position).each do |block| %>
          <% if block.title? || block.paragraph? %>
            <%= render "brochures/editor/block", block: block, page: page %>
          <% end %>
        <% end %>
      </div>

      <div class="relative">
        <div class="aspect-[4/5] overflow-hidden shadow-xl border-[12px] border-white">
          <% featured_image = page.blocks.find_by(block_type: 'image') %>
          <% if featured_image&.image&.attached? %>
                      <%= render "brochures/editor/block", block: featured_image, page: page %>
            <%# <%= image_tag featured_image.image, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full bg-slate-100 flex items-center justify-center italic text-slate-400">
              The First Date Photo
            </div>
          <% end %>
        </div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 border-2 opacity-30" style="border-color: var(--primary);"></div>
      </div>
    </div>

  </div>
</section>