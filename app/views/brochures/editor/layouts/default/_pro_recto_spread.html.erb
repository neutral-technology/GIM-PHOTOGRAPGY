<%# app/views/brochures/editor/layouts/pro/_pro_recto_spread.html.erb %>
<div class="pdf-page <%= 'watermarked' if @brochure.show_watermark? %> " style="background-color: var(--bg); padding: 0; overflow: hidden;" data-controller="editor">
  <div class="w-full h-full relative overflow-hidden">
    <% block = page.blocks.find_by(block_type: 'image') %>
    <% if block %>
      <%= render "brochures/editor/block", block: block, page: page,
          style: "width: 200% !important; height: 100%; object-fit: cover; object-position: 100% 50%; max-width: none !important;" %>
    <% end %>
  </div>
</div>