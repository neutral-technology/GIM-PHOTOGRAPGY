<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invitation de Mariage In Love</title>
    <!-- Google Fonts for Elegant Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Great+Vibes&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --burgundy: #6B1D2F;
            --deep-burgundy: #4A101D;
            --gold: #D4AF37;
            --rose-muted: #B3888F;
            --cream: #FDFBF7;
            --text-dark: #333333;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            /* background-color: #1a060a; */
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px 0;
        }

        /* Mobile Container Simulation */
        .phone-container {
            width: 100%;
            max-width: 412px;
            height: 844px;
            background-color: var(--cream);
            border-radius: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            overflow-y: auto;
            overflow-x: hidden;
            scroll-behavior: smooth;
            position: relative;
            border: 8px solid #222;
        }

        /* Hide scrollbar for Chrome, Safari and Opera */
        .phone-container::-webkit-scrollbar {
            display: none;
        }

        /* Custom Section Divider */
        .divider {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 20px auto;
            width: 60%;
        }
        .divider::before, .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--gold);
        }
        .divider-flower {
            color: var(--gold);
            padding: 0 10px;
            font-size: 12px;
        }

        /* SECTION 1: HERO SCREEN */
        .hero-section {
            height: 100%;
            background: linear-gradient(var(--bg), var(--primary)), url('red.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            text-align: center;
            padding: 60px 20px 40px 20px;
            color: #ffffff;
            position: relative;
        }

        .hero-subtitle {
            font-family: 'Cinzel', serif;
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold);
        }

        .we-do-container {
            margin-top: auto;
            margin-bottom: 20px;
        }

        .we-do-text {
            font-family: 'Great Vibes', cursive;
            font-size: 65px;
            color: #ffffff;
            line-height: 1;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }

        .hero-names {
            font-family: 'Cinzel', serif;
            font-size: 28px;
            font-weight: 400;
            letter-spacing: 2px;
            margin: 15px 0;
            text-transform: uppercase;
        }

        .hero-invitation-text {
            font-size: 11px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            max-width: 80%;
            margin: 0 auto;
            opacity: 0.9;
            font-weight: 300;
            line-height: 1.6;
        }

        .date-badge {
            border-top: 1px solid rgba(212, 175, 55, 0.4);
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            padding: 10px 0;
            margin-top: auto;
            width: 85%;
            display: flex;
            justify-content: space-around;
            align-items: center;
            font-family: 'Cinzel', serif;
            font-size: 12px;
            letter-spacing: 1px;
        }

        .date-main {
            font-size: 26px;
            font-weight: 600;
            color: var(--gold);
        }

        .scroll-btn {
            margin-top: 25px;
            background: none;
            border: none;
            color: #fff;
            font-size: 20px;
            cursor: pointer;
            animation: bounce 2s infinite;
        }

        /* SECTION 2: DETAILS SCREEN */
        .details-section {
            padding: 50px 30px;
            background-color: var(--cream);
            text-align: center;
        }

        .section-title {
            font-family: 'Great Vibes', cursive;
            font-size: 45px;
            color: var(--primary);
            margin-bottom: 5px;
        }

        .detail-block {
            margin-bottom: 40px;
        }

        .detail-subtitle {
            font-family: 'Cinzel', serif;
            font-size: 14px;
            letter-spacing: 2px;
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .detail-text {
            font-size: 12px;
            line-height: 1.8;
            color: #555;
            font-weight: 300;
        }

        /* Color Palette Display */
        .color-palette {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 15px;
        }

        .color-circle {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            box-shadow: 0 2px 5px rgba(0,0,0,0.15);
        }

        /* SECTION 3: RSVP SCREEN */
        .rsvp-section {
            padding: 50px 30px;
            background-color: #ffffff;
            text-align: center;
            border-top: 1px solid #f0eae1;
        }

        .rsvp-deadline {
            font-family: 'Cinzel', serif;
            font-size: 12px;
            letter-spacing: 2px;
            color: var(--text-dark);
            margin-top: 10px;
            margin-bottom: 25px;
        }

        .rsvp-form {
            text-align: left;
            margin-top: 20px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 6px;
            color: var(--burgundy);
            font-weight: 600;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 13px;
            background-color: var(--cream);
            color: var(--text-dark);
        }

        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: var(--burgundy);
        }

        .submit-btn {
            width: 100%;
            padding: 12px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 4px;
            font-family: 'Cinzel', serif;
            font-size: 13px;
            letter-spacing: 2px;
            cursor: pointer;
            transition: background 0.3s;
            margin-top: 10px;
        }

        .submit-btn:hover {
            background-color: var(--deep-burgundy);
        }

        .thank-you-text {
            font-family: 'Great Vibes', cursive;
            font-size: 40px;
            color: var(--primary);
            margin-top: 40px;
        }

        /* Animations */
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }
    </style>
</head>
<body>

    <!-- Phone Wrapper Simulation -->
    <div class="phone-container relative overflow-hidden h-full w-full">
        <% paragraph_blocks = page.blocks.where(block_type:"paragraph") %>
        <% image = page.blocks.find_by(block_type:"image") %>

        <!-- SECTION 1: HERO SCREEN -->
        <section class="hero-section relative w-full h-full min-h-screen flex flex-col justify-between items-center text-center p-5" id="hero">
            <% if image %>
              <div class="absolute inset-0 w-full h-full z-0 object-cover-container">
                <%= render "brochures/editor/block", block: image, page: page %>
              </div>
            <% end %>
            <div class="absolute inset-0 opacity-40 z-10 pointer-events-none"
                        style="background: linear-gradient(rgba(24, 9, 9, 0.38), rgb(50, 25, 25));"></div>
            <div class="relative z-20 w-full h-full flex flex-col justify-between items-center gap-6">
                <p class="hero-subtitle">Accompagnés de nos familles</p>
                <div class="we-do-container">
                    <h1 class="we-do-text">Nous faisons</h1>
                    <h1 class="we-do-text">le grand saut</h1>
                    <h2 class="hero-names">
                          <%= render "brochures/editor/block", 
                            block: paragraph_blocks[0], 
                            page: page, 
                            bare: true, 
                            class: "" if paragraph_blocks[0] %>
                    </h2>
                    <p class="hero-invitation-text">Vous invitent à les suivre dans la célébration de leur amour</p>
                </div>

                <div class="date-badge">
                    <div>
                      <%= render "brochures/editor/block", 
                            block: paragraph_blocks[1], 
                            page: page, 
                            bare: true, 
                            class: "" if paragraph_blocks[1] %>
                    </div>
                    <div>
                      <div>
                          <%= render "brochures/editor/block", 
                            block: paragraph_blocks[3], 
                            page: page, 
                            bare: true, 
                            class: "" if paragraph_blocks[3] %>
                      </div>
                      <div class="date-main">
                           <%= render "brochures/editor/block", 
                              block: paragraph_blocks[2], 
                              page: page, 
                              bare: true, 
                              class: "" if paragraph_blocks[2] %>
                      </div>
                      <div>
                          <%= render "brochures/editor/block", 
                            block: paragraph_blocks[3], 
                            page: page, 
                            bare: true, 
                            class: "" if paragraph_blocks[3] %>
                      </div>
                    </div>
                    <div>
                        <div>
                          <%= render "brochures/editor/block", 
                            block: paragraph_blocks[4], 
                            page: page, 
                            bare: true, 
                            class: "" if paragraph_blocks[4] %>
                            
                        </div>
                    </div>
                </div>

                <button class="scroll-btn" onclick="document.getElementById('details').scrollIntoView();">&#x2193;</button>
            </div>
        </section>

        <!-- SECTION 2: DETAILS SCREEN -->
        <section class="details-section" id="details">
            <h2 class="section-title">Détails</h2>
            <div class="divider"><span class="divider-flower">&#10047;</span></div>
            
            <!-- Code Vestimentaire -->
            <div class="detail-block">
                <h3 class="detail-subtitle">Code Vestimentaire</h3>
                <p class="detail-text">
                  Couleur:
                  <%= render "brochures/editor/block", 
                        block: paragraph_blocks[5], 
                        page: page, 
                        bare: true, 
                        class: "" if paragraph_blocks[5] %>
                </p>
                <p class="detail-text">
                    Semi-formal et élégant. Les tissus légers ainsi que les couleurs douces et estivales sont chaleureusement bienvenus.
                </p>
                <div class="color-palette">
                    <div class="color-circle" style="background-color: var(--primary);"></div>
                    <div class="color-circle" style="background-color: #B3888F;"></div>
                    <div class="color-circle" style="background-color: #D4AF37;"></div>
                </div>
            </div>

            <!-- Transport -->
            <div class="detail-block">
                <h3 class="detail-subtitle">Cadeaux & Enveloppes</h3>
                <p class="detail-text">
                  Votre présence est le plus beau des cadeaux. Cependant,
                  si vous souhaitez contribuer à notre nouvelle vie à deux
                  ou à notre voyage de noces, une urne sera à votre disposition
                  lors de la réception.
                </p>
            </div>

            <!-- Hébergement -->
            <div class="detail-block">
                <h3 class="detail-subtitle">À très vite !</h3>
                <p class="detail-text">
                  Plus qu'un simple événement, ce mariage est l'occasion
                  de réunir toutes les personnes qui comptent le plus pour nous.
                  Nous avons hâte de partager ces éclats de rire et cette émotion
                  à vos côtés.
                </p>
            </div>
            
            <button class="submit-btn" style="width: auto; padding: 10px 25px;" onclick="document.getElementById('rsvp').scrollIntoView();">Confirmer Présence</button>
        </section>

        <!-- SECTION 3: RSVP SCREEN -->
        <section class="rsvp-section" id="rsvp">
            <h2 class="section-title">R.S.V.P</h2>
            <p class="rsvp-deadline">
              AVANT LE <%= render "brochures/editor/block", 
                        block: paragraph_blocks[6], 
                        page: page, 
                        bare: true, 
                        class: "" if paragraph_blocks[6] %>
            </p>
            <div class="divider"><span class="divider-flower">&#10047;</span></div>
            
            <p class="detail-text" style="font-style: italic;">
                Veuillez s'il vous plaît clicker ci-dessous
                pour nous confirmer votre présence.
            </p>

            <% if defined?(guest) && guest.present? %>
              <p class="mt-8 uppercase text-xl" style="color:var(--text)">
                Cher <strong> <%= guest.name %> </strong>
              </p>
              <% if guest.pending? %>
                <p class="detail-text" style="color:var(--text)">
                  Merci de confirmer votre présence.
                </p>
                <%= form_with url: invitation_path(guest.token),
                      method: :patch,
                      class:"mt-10 flex flex-col gap-4" do %>
                  <button name="status" value="accepted"
                    class="py-4 rounded-full detail-text text-white"
                    style="background:var(--primary); color:var(--text);"
                  >
                    ✨ Je serai présent
                  </button>
                  <button name="status" value="declined" class="detail-text py-4 rounded-full border" style="color:var(--text);">
                    Je ne pourrai pas venir
                  </button>
                <% end %>
                <% elsif guest.accepted? %>
                  <div class="mt-8 p-6 rounded-2xl bgwhite shadow-xl" style="color:var(--text);">
                    <h3 class="font-bold text-xl">
                      Présence confirmée ✨
                    </h3>
                    <p class="mt-3">
                      Votre table :<strong> <%= guest.table %> </strong>
                    </p>
                    <div class="mt-6">
                      <%= image_tag qr_code_for(
                        invitation_url(guest.token)
                      ),
                      class:"w-32 mx-auto" %>
                    </div>
                    <p class="mt-4 text-sm">
                      Présentez ce QR code à l'entrée
                    </p>
                  </div>
                <% elsif guest.declined? %>
                  <p class="mt-10 text-red-600">
                    Merci pour votre réponse,
                    nous comprenons votre indisponibilité.
                  </p>
                <% end %>
              <% else %>
                <p class="mt-8" style="color:var(--text);">
                  Merci de confirmer votre présence.
                </p>
              <% end %>
            <h3 class="thank-you-text">Merci !</h3>
        </section>
    </div>

</body>
</html>