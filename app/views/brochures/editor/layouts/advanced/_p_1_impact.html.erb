<div class="pdf-page" 
     style="width: 210mm; height: 297mm; background-color: var(--bg); break-after: page; padding: 0;" data-controller="editor">
  
  <div class="w-full h-full relative">
    <% block = page.blocks.find_by(block_type: 'image') %>
    <%= render "brochures/editor/block", block: block, page: page if block %>
    
    <%# Subtle page number at bottom for continuity %>
    <div class="absolute bottom-10 left-0 right-0 text-center text-white/50 text-[10px] tracking-widest">
      — SELECTION EXCLUSIVE —
    </div>
  </div>
</div>