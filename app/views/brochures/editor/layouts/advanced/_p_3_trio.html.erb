<div class="pdf-page <%= 'watermarked' if @brochure.show_watermark? %> sortable block" style="background-color: var(--bg);">
  <div class="h-full flex flex-col gap-4 overflow-hidden" style="" data-controller="editor sortable">
    
    <% blocks = page.blocks.where(block_type: 'image').order(:position).to_a %>

    <div class="flex bg-slate-50 overflow-hidden" style="height: 60%;" data-block-id="<%= blocks[0]&.id %>">
      <%= render "brochures/editor/block", block: blocks[0], page: page if blocks[0] %>
    </div>

    <div class="flex gap-4" style="height: 40%;" data-block-id="<%= blocks[1]&.id %>">
      <div class="w-full bg-slate-50 shadow-sm overflow-hidden">
        <%= render "brochures/editor/block", block: blocks[1], page: page if blocks[1] %>
      </div>
      <div class="w-full bg-slate-50 shadow-sm overflow-hidden">
        <%= render "brochures/editor/block", block: blocks[2], page: page if blocks[2] %>
      </div>
    </div>
  </div>
</div>