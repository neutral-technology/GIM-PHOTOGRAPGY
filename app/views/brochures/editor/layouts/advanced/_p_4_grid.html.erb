<div class="pdf-page <%= 'watermarked' if @brochure.show_watermark? %>" 
     style=" background-color: var(--bg); break-after: page;"
     
>
  <div class="grid grid-cols-2 grid-rows-2 gap-4 h-full block sortable" data-controller="editor sortable">
    <% page.blocks.where(block_type: 'image').order(:position).each do |block| %>
      <div class="relative w-full h-full bg-slate-50 shadow-sm sortable block overflow-hidden" data-block-id="<%= block.id %>">
        <%= render "brochures/editor/block", block: block, page: page %>
      </div>
    <% end %>
  </div>
</div>