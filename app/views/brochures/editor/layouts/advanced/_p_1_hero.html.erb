<div class="pdf-page flex items-stretch justify-center" style="background-color: var(--bg);">
  <div class="items-stretch overflow-hidden h-full"
        style="margin: -15mm; width: calc(100% + 30mm); height: calc(100% + 30mm);"
        data-controller="editor">
    <% block = page.blocks.find_by(block_type: 'image') %>
    <%= render "brochures/editor/block", block: block, page: page if block %>
  </div>
</div>