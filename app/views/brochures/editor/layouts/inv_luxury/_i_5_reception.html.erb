<%# app/views/brochures/editor/layouts/inv_classic/_i_4_event.html.erb %>
<div class="w-full h-full relative" data-controller="editor">
  
  <% paragraph_blocks = page.blocks.where(block_type:"paragraph") %>

  <div class="relative w-full h-full overflow-hidden flex flex-col justify-between items-center py-12 px-4"
       style="background: var(--bg);">

    <div class="w-full text-center mt-4 flex flex-col items-center">
      <div class="flex gap-3">
        <span class="text-4xl" 
              style="margin-bottom: 2rem; color: var(--text); font-family: 'Dancing Script', 'Great Vibes', cursive; font-weight: 500;">
          La
        </span>
        <h2 class="text-lg mt-6 uppercase tracking-[0.15em] font-bold pl-6 text-left leading-tight" 
            style="color: var(--text) font-family: 'Nunito', sans-serif;">
          cérémonie
        </h2>
      </div>
    </div>

    <div class="w-full h-full relative px-2 py-12 space-y-12">
      <!-- weeding -->
      <div class="flex gap-3 items-center relative ">
        <div class="w-12 h-12 flex justify-end">
          <%= image_tag "ring.png", alt: "GIM Service Logo",
          class: "w-full object-contain object-contain" %>
        </div>
        <div class="w-4 h-3 rounded-full shadow"
            style="background:var(--primary)">
        </div>
        <!-- text -->
        <div class="w-full">
          <h3 class="text-xl fontserif"
              style="color:var(--text)">
            <%= render "brochures/editor/block", block: paragraph_blocks[0], page: page if  paragraph_blocks[0] %>
          </h3>
          <p class="uppercase w-full text-xs tracking-widest"
            style="color:var(--text)">
            Ceremonie
          </p>
        </div>
      </div>
      <%# shoot %>
      <div class="flex gap-3 items-center relative ">
        <div class="w-12 h-12 flex justify-end">
          <%= image_tag "shoot.png", alt: "GIM Service Logo",
          class: "w-full object-contain object-contain" %>
        </div>
        <div class="w-4 h-3 rounded-full shadow"
            style="background:var(--primary)">
        </div>
        <!-- text -->
        <div class="w-full">
          <h3 class="text-xl"
              style="color:var(--text)">
            <%= render "brochures/editor/block", block: paragraph_blocks[1], page: page if  paragraph_blocks[1] %>
          </h3>
          <p class="uppercase w-full text-xs tracking-widest"
            style="color:var(--text)">
            Session shoot
          </p>
        </div>
      </div>
      <div class="flex gap-3 items-center relative ">
        <div class="w-12 h-12 flex justify-end">
          <%= image_tag "coktail.png", alt: "GIM Service Logo",
          class: "w-full object-contain object-contain" %>
        </div>
        <div class="w-4 h-3  rounded-full shadow"
            style="background:var(--primary)">
        </div>
        <!-- text -->
        <div class="w-full">
          <h3 class="text-xl fontserif"
              style="color:var(--text)">
            <%= render "brochures/editor/block", block: paragraph_blocks[2], page: page if  paragraph_blocks[2] %>
          </h3>
          <p class="uppercase w-full  text-xs tracking-widest"
            style="color:var(--text)">
            reception
          </p>
        </div>
      </div>
          <div class="flex gap-3 items-center relative ">
        <div class="w-12 h-12  flex justify-end">
          <%= image_tag "marier.webp", alt: "GIM Service Logo",
          class: "w-full object-contain object-contain" %>
        </div>
        <div class="w-4 h-3  rounded-full shadow"
            style="background:var(--primary)">
        </div>
        <!-- text -->
        <div class="w-full">
          <h3 class="text-xl fontserif"
              style="color:var(--text)">
            <%= render "brochures/editor/block", block: paragraph_blocks[3], page: page if  paragraph_blocks[3] %>
          </h3>
          <p class="uppercase w-full  text-xs tracking-widest"
            style="color:var(--text)">
            entrée des mariés
          </p>
        </div>
      </div>
          <div class="flex gap-3 items-center relative ">
        <div class="w-12 h-12 flex justify-end">
          <%= image_tag "boom.png", alt: "GIM Service Logo",
          class: "w-full object-contain object-contain" %>
        </div>
        <div class="w-4 h-3 rounded-full shadow"
            style="background:var(--primary)">
        </div>
        <!-- text -->
        <div class="w-full">
          <h3 class="text-xl"
              style="color:var(--text)">
            <%= render "brochures/editor/block", block: paragraph_blocks[4], page: page if  paragraph_blocks[4] %>
          </h3>
          <p class="uppercase w-full  text-xs tracking-widest"
            style="color:var(--text)">
            que la fête commence
          </p>
        </div>
      </div>
    </div>
  </div>
</div>