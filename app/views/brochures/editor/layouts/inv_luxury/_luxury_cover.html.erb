<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Julia & Andrew - Invitation de Mariage</title>
    <!-- Google Fonts for Luxury & Ornate Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=Pinyon+Script&family=Montserrat:wght@200;400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-dark: #111111;
            --bg-gradient: linear-gradient(135deg, #1c1c1c 0%, #0a0a0a 100%);
            --gold-gradient: linear-gradient(145deg, #ffe596 0%, #cda242 50%, #ae8027 100%);
            --gold-light: #f3e1b6;
            --gold-base: #cda242;
            --text-light: #e0e0e0;
            --text-muted: #a0a0a0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #050505;
            color: var(--text-light);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px 0;
        }

        /* Mobile Container Simulation */
        .phone-container {
            width: 100%;
            max-width: 412px;
            height: 844px;
            background: var(--bg-gradient);
            border-radius: 40px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.8);
            overflow-y: auto;
            overflow-x: hidden;
            scroll-behavior: smooth;
            position: relative;
            border: 8px solid #262626;
        }

        .phone-container::-webkit-scrollbar {
            display: none;
        }

        /* Luxury Ornate Borders */
        .lace-corner {
            position: absolute;
            width: 100px;
            height: 100px;
            opacity: 0.25;
            pointer-events: none;
            border: 2px dashed var(--gold-base); /* Fallback simulation of ornate lace */
        }
        
        /* Gold text gradient helper */
        .gold-text {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 500;
        }

        /* SECTION 1: MAIN LANDING */
        .hero-section {
            min-height: 100%;
            padding: 50px 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .we-do-header {
            font-family: 'Cinzel', serif;
            font-size: 24px;
            letter-spacing: 4px;
            margin-top: 10px;
        }
        
        .we-do-header span {
            font-family: 'Pinyon Script', cursive;
            font-size: 45px;
            vertical-align: middle;
            margin: 0 10px;
        }

        /* Vintage Oval Picture Frame Container */
        .photo-frame-container {
            margin: 30px 0;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .oval-frame {
            width: 210px;
            height: 280px;
            border-radius: 50% / 50%;
            background: url('rsvp 1.jpg') center center no-repeat;
            background-size: cover;
            border: 6px double #cda242;
            box-shadow: 0 0 0 2px #111, 0 15px 35px rgba(0,0,0,0.6);
            position: relative;
            z-index: 2;
        }

        .frame-shadow {
            position: absolute;
            width: 220px;
            height: 290px;
            border-radius: 50% / 50%;
            background: transparent;
            border: 1px solid rgba(255, 229, 150, 0.2);
            z-index: 1;
        }

        .intro-phrase {
            font-style: italic;
            font-size: 11px;
            letter-spacing: 1px;
            color: var(--text-muted);
            font-weight: 200;
        }

        .couple-names {
            font-family: 'Cinzel', serif;
            font-size: 26px;
            letter-spacing: 2px;
            margin: 10px 0;
        }

        .wedding-date {
            font-family: 'Pinyon Script', cursive;
            font-size: 42px;
            color: var(--gold-light);
            margin: 5px 0;
        }

        .wedding-time {
            font-family: 'Cinzel', serif;
            font-size: 12px;
            letter-spacing: 3px;
            color: var(--text-light);
        }

        /* SECTION 2: COUNTDOWN & RSVP GATE */
        .countdown-section {
            min-height: 100%;
            padding: 60px 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            align-items: center;
            background: rgba(10, 10, 10, 0.85);
            text-align: center;
        }

        .countdown-title {
            font-family: 'Cinzel', serif;
            font-size: 12px;
            letter-spacing: 3px;
            color: var(--text-light);
            text-transform: uppercase;
        }

        /* Live Countdown Grid */
        .countdown-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            width: 100%;
            margin: 30px 0;
        }

        .countdown-box .number {
            font-family: 'Cinzel', serif;
            font-size: 28px;
            font-weight: 300;
            color: var(--gold-light);
            display: block;
        }

        .countdown-box .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-top: 5px;
        }

        /* Large Stylized RSVP Letters */
        .rsvp-monogram {
            font-family: 'Cinzel Decorative', serif;
            font-size: 55px;
            line-height: 1.1;
            letter-spacing: 5px;
            margin: 20px 0;
            opacity: 0.9;
        }

        /* Luxury Button Style */
        .luxury-btn {
            background: transparent;
            border: 1px solid var(--gold-base);
            padding: 10px 30px;
            font-family: 'Cinzel', serif;
            font-size: 11px;
            letter-spacing: 3px;
            color: var(--gold-light);
            border-radius: 20px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(205, 162, 66, 0.1);
        }

        .luxury-btn:hover {
            background: var(--gold-gradient);
            color: #000;
            box-shadow: 0 4px 20px rgba(205, 162, 66, 0.4);
        }

        /* SECTION 3: DETAILS & LOGISTICS */
        .details-section {
            padding: 60px 30px;
            text-align: center;
        }

        .section-title {
            font-family: 'Pinyon Script', cursive;
            font-size: 50px;
            color: var(--gold-light);
            margin-bottom: 25px;
        }

        .detail-card {
            margin-bottom: 45px;
        }

        .detail-label {
            font-family: 'Cinzel', serif;
            font-size: 14px;
            letter-spacing: 3px;
            color: var(--gold-base);
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        .detail-desc {
            font-size: 11px;
            line-height: 1.8;
            color: var(--text-muted);
            font-weight: 300;
            max-width: 90%;
            margin: 0 auto;
        }

        /* Elegant Skin-Tone Color Palette Circles */
        .palette-container {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 18px;
        }

        .color-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* Icon Graphic placeholder */
        .icon-graphic {
            width: 50px;
            height: 40px;
            margin: 15px auto;
            border-bottom: 1px dashed var(--gold-base);
            position: relative;
        }

        .venue-title {
            font-family: 'Pinyon Script', cursive;
            font-size: 30px;
            color: var(--text-light);
            margin-bottom: 5px;
        }
    </style>
</head>
<body>

    <!-- Phone Wrapper Simulation -->
    <div class="phone-container">
        
        <!-- SECTION 1: HERO SCREEN -->
        <section class="hero-section" id="hero">
            <h2 class="we-do-header gold-text">WE<span>&#9825;</span>DO</h2>
            
            <!-- Picture Frame using rsvp 1.jpg -->
            <div class="photo-frame-container">
                <div class="frame-shadow"></div>
                <div class="oval-frame"></div>
            </div>

            <div>
                <p class="intro-phrase">Avec un cœur rempli d'amour</p>
                <h1 class="couple-names"><span class="gold-text">Julia</span> & <span class="gold-text">Andrew</span></h1>
                <p class="intro-phrase" style="text-transform: uppercase; letter-spacing: 2px;">Vous invitent à célébrer leur union</p>
                
                <h2 class="wedding-date">Juillet 15, 2026</h2>
                <p class="wedding-time">À 15h00</p>
            </div>
            
            <button class="luxury-btn" style="margin-top: 20px;" onclick="document.getElementById('countdown').scrollIntoView();">Continuer</button>
        </section>

        <!-- SECTION 2: COUNTDOWN & RSVP -->
        <section class="countdown-section" id="countdown">
            <h3 class="countdown-title">Nous avons hâte de fêter ça avec vous !</h3>
            
            <!-- Live Grid Countdown -->
            <div class="countdown-grid">
                <div class="countdown-box">
                    <span class="number" id="days">00</span>
                    <span class="label">Jours</span>
                </div>
                <div class="countdown-box">
                    <span class="number" id="hours">00</span>
                    <span class="label">Heures</span>
                </div>
                <div class="countdown-box">
                    <span class="number" id="minutes">00</span>
                    <span class="label">Min</span>
                </div>
                <div class="countdown-box">
                    <span class="number" id="seconds">00</span>
                    <span class="label">Sec</span>
                </div>
            </div>

            <div>
                <p class="intro-phrase" style="text-transform: uppercase; letter-spacing: 3px;">S'il vous plaît</p>
                <h2 class="rsvp-monogram gold-text">RSVP</h2>
                <p class="intro-phrase" style="margin-bottom: 20px;">AVANT LE 1er MARS</p>
            </div>

            <button class="luxury-btn" onclick="alert('Lien vers le formulaire RSVP activé !');">Répondre Ici</button>
        </section>

        <!-- SECTION 3: DETAILS SCREEN -->
        <section class="details-section" id="details">
            <h2 class="section-title">Détails</h2>
            
            <!-- Code Vestimentaire -->
            <div class="detail-card">
                <h3 class="detail-label">Code Vestimentaire</h3>
                <p class="detail-desc">
                    Nous prions gentiment nos invités de se vêtir d'une tenue de soirée élégante.
                </p>
                <div class="palette-container">
                    <div class="color-dot" style="background-color: #5C3A21;"></div>
                    <div class="color-dot" style="background-color: #C37A3E;"></div>
                    <div class="color-dot" style="background-color: #E2A782;"></div>
                    <div class="color-dot" style="background-color: #F6CBB2;"></div>
                </div>
            </div>

            <!-- Réception -->
            <div class="detail-card">
                <h3 class="detail-label">Réception</h3>
                <p class="detail-desc">
                    La réception aura lieu immédiatement après la fin de la cérémonie officielle.
                </p>
                <div class="icon-graphic"></div>
            </div>

            <!-- Lieu -->
            <div class="detail-card">
                <h3 class="detail-label">Lieu de l'événement</h3>
                <h4 class="venue-title">The Rose Garden</h4>
                <p class="detail-desc" style="font-style: italic;">
                    123 Avenue des Fleurs<br>Paris, France
                </p>
            </div>

            <button class="luxury-btn" onclick="document.getElementById('hero').scrollIntoView();">Retour au début</button>
        </section>

    </div>

    <!-- Live Countdown JavaScript Script -->
    <script>
        // Set your target wedding date countdown here
        const targetDate = new Date("July 15, 2026 15:00:00").getTime();

        const countdownInterval = setInterval(function() {
            const now = new Date().getTime();
            const difference = targetDate - now;

            // Calculations for days, hours, minutes and seconds
            const days = Math.floor(difference / (1000 * 60 * 60 * 24));
            const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((difference % (1000 * 60)) / 1000);

            // Display results in the matching elements
            document.getElementById("days").innerText = days < 10 ? "0" + days : days;
            document.getElementById("hours").innerText = hours < 10 ? "0" + hours : hours;
            document.getElementById("minutes").innerText = minutes < 10 ? "0" + minutes : minutes;
            document.getElementById("seconds").innerText = seconds < 10 ? "0" + seconds : seconds;

            // If countdown is finished
            if (difference < 0) {
                clearInterval(countdownInterval);
                document.getElementById("countdown").innerHTML = "<h3 class='countdown-title gold-text'>C'est le grand jour !</h3>";
            }
        }, 1000);
    </script>
</body>
</html>