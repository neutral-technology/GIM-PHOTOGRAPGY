<div class="pdf-page sortable block relative items-stretch flex items-center justify-center overflow-hidden" 
     style="background-color: var(--bg); break-after: page; padding: 15mm; box-sizing: border-box;"
     data-controller="editor">
  <% blocks = page.blocks.where(block_type: 'image') %>

  <div class="absolute top-0 overflow-hidden" style="
    border-top: 100%;
    border-bottom-right-radius: 500px; 
    border-bottom-left-radius: 500px; 
    width: 47%;
    border: 2px solid white;
    left: 15mm; 
    height: 70%;
    z-index: 20;
    ">
    <%= render "brochures/editor/block", block: blocks[0], page: page if blocks[2] %>
  </div>

  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-full overflow-hidden rounded-full border-8 border-white shadow-2xl"
  style="
    width: 60%; 
    height: 100%; 
    transform: translate(-50%, -50%); 
    -webkit-transform: translate(-50%, -50%); 
    border-radius: 50% / 40%; 
    z-index: 30;">
    <%= render "brochures/editor/block", block: blocks[1], page: page if blocks[1] %>
  </div>

  <div class="absolute right-0 bottom-0 w-2/5 h-1/2 overflow-hidden"
  style=" 
    width: 50%; 
    height: 70%; 
    border-top-left-radius: 500px; 
    border-top-right-radius: 500px; 
    border: 2px solid white; 
    z-index: 20;">
    <%= render "brochures/editor/block", block: blocks[2], page: page if blocks[2] %>
  
  </div>
  
  <div class="absolute uppercase flex flex-col items-end text-right" style="
  right: 8mm;
  width: 35%;
  z-index: 40;">
  <% title_block = page.blocks.find_by(block_type: 'title') %>
  <% if title_block %>
  <div class=" w-[70%]">
    <%= render "brochures/editor/block", block: title_block, page: page %>
  </div>
  <% end %>

  <% paragraph = page.blocks.find_by(block_type: 'paragraph') %>
  <% if paragraph %>
      <%= render "brochures/editor/block", block: paragraph, page: page %>
  <% end %>
</div>
</div>