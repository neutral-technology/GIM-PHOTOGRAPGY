<div class="pdf-page relative overflow-hidden flex items-center justify-center" 
     style="background-color: var(--bg); break-after: page; padding: 0;" data-controller="editor">

  <%# 1. THE CLUSTER CONTAINER %>
  <div class="relative w-full h-full items-center overflow-hidden">
    
    <% block = page.blocks.where(block_type: 'image').limit(3) %>

    <%# LARGE CENTRAL BUBBLE %>
    <div class="absolute overflow-hidden shadow-xl"
         style="width: 420px; z-index: 30; height: 420px; border-radius: 50%; border: 12px solid white;
                bottom: 10%; left: 50%; transform: translateX(-50%);" data-block-id="<%= block[0]&.id %>" >
      <%= render "brochures/editor/block", block: block[0], page: page if block[0] %>
    </div>

    <%# LEFT MIDDLE BUBBLE %>
    <div class="absolute overflow-hidden shadow-lg"
         style=" z-index: 20; width: 240px; height: 240px; border-radius: 50%; border: 10px solid white;
                bottom: 15%; left: 10%;" data-block-id="<%= block[1]&.id %>" >
      <%= render "brochures/editor/block", block: block[1], page: page if block[1] %>
    </div>

    <%# TOP CENTER BUBBLE %>
    <div class="absolute z-10 overflow-hidden shadow-md"
         style="width: 300px; height: 300px; border-radius: 50%; border: 8px solid white;
                top: 10%; left: 30%;">
      <%= render "brochures/editor/block", block: block[1], page: page if block[1] %>
    </div>

    <%# RIGHT MIDDLE BUBBLE %>
    <div class="absolute  overflow-hidden shadow-lg"
         style="width: 250px; z-index: 40; height: 250px; border-radius: 50%; border: 10px solid white;
                bottom: 30%; right: 10%;">
      <%= render "brochures/editor/block", block: block[2], page: page if block[2] %>
    </div>

    <%# SMALL ACCENT BUBBLE %>
    <div class="absolute z-30 overflow-hidden shadow-md"
         style="width: 160px; z-index: 50; height: 160px; border-radius: 50%; border: 6px solid white;
                top: 29%; right: 28%;">
      <%= render "brochures/editor/block", block: block[2], page: page if block[2] %>
    </div>
  </div>
</div>