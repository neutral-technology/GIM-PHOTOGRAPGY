<%# app/views/brochures/editor/layouts/pro/_pro_editorial_pills.html.erb %>

<div class="pdf-page <%= 'watermarked' if @brochure.show_watermark? %> relative overflow-hidden flex flex-col justify-center p16" 
     style="background-color: var(--bg); break-after: page; padding15mm; box-sizing: border-box;"
     data-controller="editor">
  

  <div class="flex flex-col items-center justify-around w-full mt12">
    <%# 1. TOP NAVIGATION / HEADER %>
    <div class="w-full flex justify-between items-center">
      <div class="text-[10px] tracking-[0.4em] font-bold">☁︎</div>
      <div class="flex justify-end gap-8 text-[9px] uppercase tracking-[0.3em] text-slate-400">
        <span>un jour</span>
        <span>Un regard</span>
        <span>une flame</span>
        <span class="text-slate-900 font-bold">une vie</span>
      </div>
      <div class="text-[9px] uppercase tracking-[0.3em] font-medium"> une eternité →</div>
    </div>
    
    <div class="flex gap-3 items-center justify-between w-full">
      <%# 2. LEFT SECTION: LARGE TYPOGRAPHY %>
        <%# 1. LARGE TYPOGRAPHY SECTION %>
      <div class="relative w-1/3 text-xl flex flex-col gap-8 justify-end items-end" style="">
        <div class="mb-8 w-full uppercase items-center flex justify-end h-full overflow-hidden " style="font-size: 7rem !important; overflow-wrap: break-word; line-height: 1;">
          pour <br> la vie ...
        </div>
        <div class=" items-end w-full" style="">
            <% title_block = page.blocks.find_by(block_type: 'title') %>
            <%= render "brochures/editor/block", block: title_block, page: page if title_block %>
        </div>
      </div>

      <%# 3. RIGHT SECTION: STAGGERED OVALS %>
      <div class="w-2/3 flex items-center gap-6 justify-end">
        <% [0, 1, 2].each do |i| %>
          <div class="flex flex-col items-center" style="margin-top: <%= i == 1 ? '-4rem' : '4rem' %>;">
            <%# Oval Container %>
            <div class="relative shadow-xl mb-10
                " style="border-radius: 50% / 40%; height: 300px; width: 200px;">
              <% block = page.blocks.where(block_type: 'image')[i] %>
              <% if block %>
              <div class="w-full h-full overflow-hidden"  style="border-radius: 50% / 40%; height: 300px; width: 200px;">
                <%= render "brochures/editor/block", block: block, page: page %>
              </div>
              <% end %>
                <%# Small Number Overlay %>
                <% [0, 1,2 ].length.times do %>
                <div class="absolute bottom-8 right-6 text-white text-2xl font-serif italic z-20 opacity-90" style="font-size: 64px; color: var(--text); left: 65%; top: 88%;">
                  ❤
                </div>
              <% end %>
            </div>

            <%# Oval Labeling %>
            <div class="text-center">
              <span class="block text-[8px] uppercase tracking-[0.4em] text-slate-300 mb-1">❤︎ ❤︎ ❤︎</span>
              <p class="text-[10px] font-serif italic text-slate-500">
                  <%= ["UN JOUR UN REGARD", "AU COEUR EN FLAME ", "QUI BRÛLE D'AMOUR "][i] %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>