<%# app/views/brochures/editor/layouts/inv_classic/_i_9_venue.html.erb %>
<div class="w-full h-full relative" data-controller="editor">

  <% title_block = page.blocks.find_by(block_type: "title") %>
  <% image_block = page.blocks.find_by(block_type: "image") %>
  <% paragraph_block = page.blocks.find_by(block_type: "paragraph") %>

  <div class="relative w-full h-full overflow-hidden flex flex-col justify-between items-center py-12 px-6"
       style="background-color: var(--bg);">
    <div class="w-full text-center mt-4 flex flex-col gap-1">
      <h2 class="text-4xl  tracking-wide" 
          style="font-family: 'Dancing Script', 'Great Vibes', cursive; font-weight: 500; color: var(--text)">
        Où nous trouver?
      </h2>
      <div class="text-sm  tracking-[0.3em] font-semibold mt-2" style="">
          <%= render "brochures/editor/block", block: title_block, page: page  if title_block %>
      </div>
    </div>

    <div class="w-full aspect-[4/5] rounded-lg overflow-hidden shadow-md border">
        <%= render "brochures/editor/block", block: image_block, page: page  if image_block %>
    </div>

    <div class="w-full px-4 mb-4">
      <a href="#" target="_blank" class="w-full h-14 rounded-md shadow flex items-center justify-center gap-3 transition-all hover:opacity-90 active:scale-[0.98]"
         style="background-color: var(--primary); color: var(--text);">
        
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-white" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>

        <div class="text-sm font-bold uppercase tracking-[0.15em]">
            <%= render "brochures/editor/block", block: paragraph_block, page: page if paragraph_block %>
        </div>
      </a>
    </div>
  </div>
</div>