<%# /Users/topazjos/Documents/neutral/projects/GIM-PHOTOGRAPGY/app/views/brochures/editor/_block.html.erb %>
<% 
  # Récupération des options locales avec valeurs par défaut
  custom_class = local_assigns[:class] || ""
  bare = local_assigns[:bare] || false 
%>

<div class="block h-full w-full group <%= custom_class %>" 
     data-block-id="<%= block&.id %>"
     data-type="<%= block.block_type %>"
     style="<%= 'display: inline;' if bare %>"
>

  <% if block.title? %>
    <% if bare %>
      <%# Version épurée : pas de h2, pas de centrage, hérite du parent %>
      <span class="animate-slide-down inline-block"
            <% if @editing %>
              contenteditable="true"
              data-editable
              data-action="blur->editor#saveText"
              data-field="content"
            <% end %>
            data-block-id="<%= block.id %>"
      >
        <%= block.content.presence || "Votre Titre" %>
      </span>
    <% else %>
      <%# Version standard de votre bloc %>
      <div class="text-center">
        <h2 class="animate-slide-down text-4xl md:text-6xl font-serif tracking-tight"
              style="color: var(--primary); font-family: var(--font-main);"
              <% if @editing %>
                contenteditable="true"
                data-editable
                data-action="blur->editor#saveText"
                data-field="content"
              <% end %>
              data-block-id="<%= block.id %>"
        >
          <%= block.content.presence || "Votre Titre" %>
        </h2>
        <div class="h-px w-24 mx-auto my-6" style="background-color: var(--primary); opacity: 0.5;"></div>
      </div>
    <% end %>
  <% end %>

  <% if block.paragraph? %>
    <% if bare %>
      <%# Version épurée : inline, hérite des polices et couleurs du parent %>
      <span class="animate-fade-in paragraph-block inline-block"
            <% if @editing %>
              contenteditable="true"
              data-editable
              data-action="blur->editor#saveText"
              data-field="content"
            <% end %>
            data-block-id="<%= block.id %>"
      >
        <%= block.content.presence || "We celebrate." %>
      </span>
    <% else %>
      <%# Version standard du paragraphe %>
      <div class="animate-fade-in paragraph-block text-lg leading-relaxed"
              style="color: var(--text); font-family: var(--font-main);"
              <% if @editing %>
                contenteditable="true"
                data-editable
                data-action="blur->editor#saveText"
                data-field="content"
              <% end %>
              data-block-id="<%= block.id %>"
      >
        <%= block.content.presence || "We celebrate." %>
      </div>
    <% end %>
  <% end %>

  <% if block.image? %>
    <div class="relative h-full w-full group">
      <div class="h-full w-full overflow-hidden shadow-2xl">
        <% if block.image.attached? %>
          <div class="relative h-full w-full">
            
            <% if @pdf_export %>
              <% begin %>
              
                <% image_binary = block.image.download %>
                <% base64_image = Base64.strict_encode64(image_binary) %>
                <img 
                  src="data:<%= block.image.content_type %>;base64,<%= base64_image %>"
                  class="animate-scale-in w-full h-full object-cover">
              
              <% rescue %>
                <%= image_tag block.image,
                  class:"w-full h-full object-cover" %>
              <% end %>
            <% else %>
              <%= image_tag block.image,
                  class:"animate-scale-in w-full h-full object-cover" %>
            <% end %>
            
            <% if @editing %>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center text-white no-print"
                style="background-color: #0000008b; z-index: 50;">
                <span class="text-xs mb-2 border p-2 rounded-xl">Remplacer l'image</span>
                <% if block.image.byte_size > 2.megabytes %>
                  <span class="text-xs p-1 rounded-xl" style="background-color: #ac050554;">
                    ⚠️ Trop large pour pdf (<%= (block.image.byte_size / 1.0.megabyte).round(2) %>MB), aumoins ~2MB.
                  </span>
                <% end %>
                <input type="file" class="cursor-pointer opacity-0 absolute inset-0"
                      data-action="change->editor#uploadImage"
                      data-block-id="<%= block.id %>">
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="w-full h-full bg-slate-200 flex flex-col items-center justify-center text-slate-400 p-4">
            <span class="text-xs italic mb-2">Photo vide</span>
            <input type="file" data-action="change->editor#uploadImage" data-block-id="<%= block.id %>">
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
