<style>
  /* 1. Make the blocks look draggable */
  .sortable .block {
    cursor: grab;
    position: relative;
    user-select: none; /* Prevents selecting text while trying to drag */
    margin-bottom: 10px;
    padding: 10px;

    /* background: var(--bg); Use the variable instead of hardcoded 'white' */
    border: 1px solid rgba(0,0,0,0.1);
  }

  /* 2. Style while dragging */
  .sortable .block:active {
    cursor: grabbing;
  }

  /* 3. Style for the "Ghost" (the placeholder where the block will land) */
  .blue-ghost-class {
    background-color: #7daff0 !important; /* light blue */
    border: 2px dashed #3b82f6 !important; /* blue border */
    opacity: 0.8 !important;
  }

  /* The item currently being moved by your mouse */
.dragging-item-class {
  opacity: 1 !important;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  transform: scale(1.02);
  z-index: 9999;
}

  /* 4. Stop images from being "dragged" by the browser's default behavior */
  .sortable .block img {
    pointer-events: none;
  }

  /* 5. Ensure editable text still allows a text cursor on click */
  .sortable .block [contenteditable="true"] {
    cursor: text;
  }

  .canvas, .page, .blocks.sortable {
    overflow: visible !important;
  }
</style>
<%# app/views/brochures/edit_layout.html.erb %>
<% brochure_theme = @brochure.theme %>
<div class="editor border mb-16 brochure-editor"
  style="--primary: <%= brochure_theme.dig('colors', 'primary') %>;
            --bg: <%= brochure_theme.dig('colors', 'background') %>;
            --text: <%= brochure_theme.dig('colors', 'text') %>;
            --font-main: <%= brochure_theme.dig('fonts', 'main') || 'Nunito' %>;">

  <h1 class="text-2xl font-bold mb-6">
    Editing brochure: <%= @brochure.title %>
  </h1>
  <aside class="sidebar">
    <%# app/views/brochures/edit_layout.html.erb %>
    <div data-controller="style-editor" 
        data-style-editor-id-value="<%= @brochure.id %>"
        class="fixed right-4 top-24 w-64 bg-white shadow-xl rounded-lg p-4 z-50 border border-slate-200">
      
      <h3 class="text-sm font-bold uppercase tracking-wider mb-4">Editeur du Style</h3>

      <div class="border">
        <button data-add="title">+ Title</button>
        <button data-add="paragraph">+ Text</button>
        <button data-add="image">+ Image</button>
      </div>
      <div class="my-3 flex items-center gap-2 justify-between ">
        <div class="">
          <label class="text-xs mb-1">Theme</label>
          <input type="color" 
                value="<%= @brochure.theme.dig('colors', 'primary') %>"
                data-action="input->style-editor#update"
                data-style-editor-target="primary"
                class="w-12 h-8 rounded cursor-pointer">
        </div>

        <div class="">
          <label class="text-xs mb-1">Font</label>
          <input type="color" 
                value="<%= @brochure.theme.dig('colors', 'background') %>"
                data-action="input->style-editor#update"
                data-style-editor-target="bg"
                class="w-12 h-8 rounded cursor-pointer">
        </div>
          <div>
          <label class="text-xs mb-1">Texte</label>
          <input type="color" 
                value="<%= @brochure.theme.dig('colors', 'text') %>"
                data-action="input->style-editor#update"
                data-style-editor-target="text"
                class="w-12 h-8 rounded cursor-pointer">
        </div>
      </div>
      <div>
        <label class="text-xs mb-1">Typography</label>
        <select data-action="change->style-editor#update" 
                data-style-editor-target="font"
                class="w-full text-xs rounded border-gray-300">
          <option value="Nunito, sans-serif">Modern (Nunito)</option>
          <option value="'Playfair Display', serif">Elegant (Serif)</option>
          <option value="'Dancing Script', cursive">Romantic (Script)</option>
        </select>
      </div>
    <button data-action="click->style-editor#save" 
            class="w-full bg-black text-white text-xs py-2 rounded mt-4 hover:bg-gray-800 transition">
      Enrégistrer les Styles
    </button>
    </div>
  </aside>

  <main class="canvas min-h-screen"
        style="background-color: var(--bg);
              color: var(--text);
              font-family: var(--font-main);">
    <% @brochure.pages.each do |page| %>
      <%= render "/brochures/editor/layouts/#{page.layout}",
                  page: page,
                  theme: brochure_theme
                %>
      
    <% end %>
  </main>
    <%= link_to "back",
        brochure_path(@brochure),
        class: "text-info text-sm mb-6",
        # target: "_blank",
        title: "View html" %>
</div>
