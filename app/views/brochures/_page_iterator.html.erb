<%# app/views/brochures/_page_iterator.html.erb %>
<%= stylesheet_link_tag  "pdf", media: "all" %>
<% brochure_theme = @brochure.theme %>
<% if editing %>
  <aside class="sidebar mb-4">
    <div data-controller="style-editor" 
        data-style-editor-id-value="<%= @brochure.id %>"
        class="right-4 top-24 w-64 bg-white shadow-xl rounded-lg p-4 z-50 border border-slate-200">
      
      <h3 class="text-sm font-bold uppercase tracking-wider mb-4">Editeur (<%= @brochure.title %>)</h3>
      <%# <div class="border">
        <button data-add="title">+ Title</button>
        <button data-add="paragraph">+ Text</button>
        <button data-add="image">+ Image</button>
      </div> %>
      <%# THEM,  FONT AND TEXT %>
      <div class="my-3 flex items-center gap-3 justify-between ">
        <div class="">
          <label class="text-xs mb-1">Theme</label>
          <input type="color" 
                value="<%= @brochure.theme.dig('colors', 'primary') %>"
                data-action="input->style-editor#update"
                data-style-editor-target="primary"
                class="w-12 h-8 rounded cursor-pointer">
        </div>

        <div class="">
          <label class="text-xs mb-1">Font</label>
          <input type="color" 
                value="<%= @brochure.theme.dig('colors', 'background') %>"
                data-action="input->style-editor#update"
                data-style-editor-target="bg"
                class="w-12 h-8 rounded cursor-pointer">
        </div>
          <div>
          <label class="text-xs mb-1">Texte</label>
          <input type="color" 
                value="<%= @brochure.theme.dig('colors', 'text') %>"
                data-action="input->style-editor#update"
                data-style-editor-target="text"
                class="w-12 h-8 rounded cursor-pointer">
        </div>
      </div>
      <%# TYPROGRAPHY %>
      <div>
        <label class="text-xs mb-1">Typography</label>
        <select data-action="change->style-editor#update" 
                data-style-editor-target="font"
                class="w-full text-xs rounded border-gray-300">
          <option value="Nunito, sans-serif">Modern (Nunito)</option>
          <option value="'Playfair Display', serif">Elegant (Serif)</option>
          <option value="'Dancing Script', cursive">Romantic (Script)</option>
        </select>
      </div>
      <%# --- Section Choix de Couverture --- %>
      <div class="mt-6 pt-4 border-t border-slate-100">
        <label class="text-xs font-bold uppercase tracking-wider mb-3 block text-slate-500">
          Design de Couverture
        </label>
        
        <div class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto pr-1">
          <%# Utilise la méthode de classe définie dans BrochurePreset pour filtrer %>
          <% BrochurePreset.compatible_covers_for(@brochure.brochure_preset.name).each do |cover| %>
            <div class="group relative cursor-pointer rounded border-2 transition-all <%= @brochure.active_cover_layout == cover[:id] ? 'border-black shadow-md' : 'border-slate-100 hover:border-slate-300' %>"
                data-action="click->style-editor#updateCover"
                data-layout-id="<%= cover[:id] %>">
              
              <div class="aspect-[3/4] bg-slate-50 flex items-center justify-center overflow-hidden">
                <%# Si vous avez des images de preview, mettez les ici, sinon un placeholder texte %>
                <span class="text-[10px] text-center px-1 font-serif uppercase tracking-tighter">
                  <%= cover[:name] %>
                </span>
              </div>
              
              <% if @brochure.active_cover_layout == cover[:id] %>
                <div class="absolute top-1 right-1 bg-black text-white rounded-full p-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="mt-6 border-t pt-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= check_box_tag(
            "watermark_enabled",
            "1",
            @brochure.watermark_enabled,
            data: {
              action: "change->style-editor#toggleWatermark"
            }
          ) %>

          <span class="text-xs">
            Watermark Preview
          </span>
        </label>
      </div>
      <%# CHANGE VALIDATION %>
      <div class="flex gap-2 justify-between mt-2">
        <button data-action="click->style-editor#save" 
                class="w-full bg-black text-white text-xs py-2 rounded mt4 hover:bg-gray-800 transition">
          Enrégistrer les Styles
        </button>
        <%= link_to "Pre-exportation",
          brochure_path(@brochure),
          class: "flex w-full bg-info-light justify-center text-info text-xs py-2 rounded hover:bg-gray-800",
          title: "Pre-exportation"
        %>
      </div>
    </div>
  </aside>
<% end %>
<div class="editor mb-16 brochure-editor"
  style="--primary: <%= brochure_theme.dig('colors', 'primary') %>;
            --bg: <%= brochure_theme.dig('colors', 'background') %>;
            --text: <%= brochure_theme.dig('colors', 'text') %>;
            --font-main: <%= brochure_theme.dig('fonts', 'main') || 'Nunito' %>;"
>
    <main class="canvas min-h-screen"
          style="color:var(--text); font-family: var(--font-main);">
      <% @brochure.pages.each_with_index do |page, index| %>
          <%# Determine if it is Recto or Verso %>
          <% if index == 0  %>
            <%# The Cover is ALWAYS Recto %>
            <% side_class = 'recto' %>
            <% layout = @brochure.active_cover_layout %>
          <% else %>
            <% side_class = index.odd? ? 'recto' : 'verso' %>
            <% layout = page.layout %>
          <% end %>

          <div class="mb-16 page-container <%= side_class %>" style="width: 297mm; height: 100%; flex-shrink: 0; position: relative;">
            <% if editing %>
              <div class="flex justify-between items-center mb-2">
                <span class="text-white -top-8 left-0 text-xs font-mono uppercase tracking-widest">
                  Page <%= index + 1 %> : <%= layout.split('/').last.titleize %>-(<%= side_class.upcase %>)
                </span>
              </div>
            <% end %>
            <%= render "/brochures/editor/layouts/#{layout}",
                      page: page,
                      theme: brochure_theme,
                      side: side_class
                    %>
          </div>
          <% if index == 0 %>
            <div class="page-container verso mb-12">
              <% if editing %>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-white -top-8 left-0 text-xs font-mono uppercase tracking-widest">
                    VERSO DE LA COUVERTURE
                  </span>
                </div>
              <% end %>
              <%# fake blank verso %>
              <div class="pdf-page flex items-center justify-center" 
                    style="background-color: var(--bg); border: 2px dashed #ccc;">
                  <div class="max-w-xs text-center opacity-30">
                    <span class="text-xl font-serif block mb-3" style="color: var(--primary);">“</span>
                    <p class="text-sm font-serif italic leading-relaxed mb-6">
                      « La photographie est un secret sur un secret. Plus elle vous en dit, moins vous en savez. »
                    </p>
                    <p class="text-sm uppercase tracking-[0.4em] opacity20">
                      Jos Kalenda • Digital Arts & Vision
                    </p>
                    <div class="text-center">
                      <p class="designer-credit">
                        © <%= Time.current.year %> <a href="https://joskalenda.netlify.app" target="_blank">https://joskalenda.netlify.app</a>
                      </p>
                      <p class="text-xs mt-2">All Rights Reserved</p>
                    </div>
                  </div>
              </div>
            </div>
          <% end %>
      <% end %>
    </main>
</div>