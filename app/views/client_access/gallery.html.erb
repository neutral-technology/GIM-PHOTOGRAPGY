<style>
/* Container and card basics (you can keep using Tailwind elsewhere) */
.gallery-card { position: relative; overflow: hidden; border-radius: 0.75rem; }

/* Hover overlay for images NOT downloaded:
   hidden by default, becomes visible when the card is hovered */
.hover-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.59); /* semi-transparent dark */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  text-align: center;
  opacity: 0;
  transition: opacity 240ms ease;
}

/* When the card is hovered, show the hover overlay */
.gallery-card:hover .hover-overlay { opacity: 1; }

/* Downloaded overlay: always visible, blurred backdrop */
.downloaded-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(255,255,255,0.06); /* subtle tint so the backdrop-filter shows */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1rem;

  /* blur the background behind the overlay (modern browsers) */
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);

  /* fallback: a little darker translucent layer for older browsers */
  /* pointer-events none so underlying download button works */
  pointer-events: none;
}

/* The download button must be clickable on top of the overlay.
   We'll place a separate clickable area on top with pointer-events:auto */
.top-button {
  position: absolute;
  inset: 0;
  display:flex;
  align-items:center;
  justify-content:center;
  pointer-events: auto; /* ensure clicks pass to the button */
}

/* small badge */
.badge {
  /* background-color: #16a34a; green-600 */
  background-color: rgba(0, 0, 0, 0.24); /* subtle tint so the backdrop-filter shows */
  color: white;
  font-size: 0.7rem;
  padding: 0.25rem 0.5rem;
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: column;
  border-radius: 0.375rem;
  margin-bottom: 0.5rem;
  pointer-events: none;
}
</style>

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
  <% @images.each do |image| %>
    <div class="gallery-card bg-white dark:bg-gray-800 rounded-xl shadow-md transform hover:scale-105 transition-transform duration-300">
      <%= image_tag image.photo, class: "w-full h-72 object-cover" %>

      <% if image.downloaded_at %>
        <!-- downloaded: blurred overlay (always visible) -->
        <div class="downloaded-overlay"
             data-delete-at="<%= (image.downloaded_at + 48.hours).to_i %>">
          <div class="countdown-text badge">téléchargé ✅, suppression dans <span class="countdown-value">calculating...</span></div>
        </div>

        <!-- clickable download button sits on top and remains active -->
        <div class="top-button">
          <%= link_to "Télécharger", rails_blob_path(image.photo, disposition: "attachment"),
              class: "text-white font-bold py-2 px-4 rounded-full border-2 border-white hover:bg-white hover:bg-opacity-20 hover:text-black transition-colors",
              data: { turbo_method: :post },
              onclick: "fetch('#{mark_downloaded_album_image_path(@album, image)}', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name=\"csrf-token\"]').content } })" %>
        </div>

      <% else %>
        <!-- not downloaded: hover-only overlay containing download button -->
        <div class="hover-overlay">
          <%= link_to "Télécharger", rails_blob_path(image.photo, disposition: "attachment"),
              class: "text-white font-bold py-2 px-4 rounded-full border-2 border-white hover:bg-white hover:bg-opacity-20 hover:text-black transition-colors",
              data: { turbo_method: :post },
              onclick: "fetch('#{mark_downloaded_album_image_path(@album, image)}', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name=\"csrf-token\"]').content } })" %>
        </div>
        <%# 437840 %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  // Live countdown for downloaded overlays
  function updateDownloadedCountdowns() {
    const now = Math.floor(Date.now() / 1000);
    document.querySelectorAll('.downloaded-overlay').forEach(overlay => {
      const deleteAt = parseInt(overlay.dataset.deleteAt, 10);
      const countdownElem = overlay.querySelector('.countdown-value');
      if (!countdownElem) return;

      const secondsLeft = deleteAt - now;
      if (secondsLeft <= 0) {
        countdownElem.textContent = "Supprimé";
      } else {
        const hours = Math.floor(secondsLeft / 3600);
        const minutes = Math.floor((secondsLeft % 3600) / 60);
        const seconds = secondsLeft % 60;
        countdownElem.textContent = `${hours}h ${minutes}m ${seconds}s`;
      }
    });
  }

  // update once per second
  setInterval(updateDownloadedCountdowns, 1000);
  updateDownloadedCountdowns();
</script>
