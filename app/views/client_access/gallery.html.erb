<div class="bg-gray-100 dark:bg-gray-900 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-center text-4xl font-extrabold text-gray-900 dark:text-gray-100 mb-2">
      <%= @album.name %> Gallery
    </h1>
    <p class="text-center text-lg text-gray-600 dark:text-gray-400 mb-10">
      Welcome👋! Vos photos sont prètes pour les télécharger.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @images.each do |image| %>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden transform hover:scale-105 transition-transform duration-300 relative group">
          <%= image_tag image.photo, class: "w-full h-72 object-cover" %>
          
          <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <%= link_to "Télécharger", rails_blob_path(image.photo, disposition: "attachment"), 
                        class: "text-white font-bold py-2 px-4 rounded-full border-2 border-white hover:bg-white hover:bg-opacity-20 hover:text-black transition-colors" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>