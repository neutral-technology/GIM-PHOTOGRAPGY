<div class="flex justify-center items-center min-h-screen">
  <div class="panel sm:w-[480px] my-6 max-w-lg w-full" x-data="{ submitting: false }">
    <h2 class="font-bold text-2xl mb-3 text-black">Bienvenue dans <%= @album.name %></h2>
    <p class="text-gray-600 dark:text-gray-400 mb-6">Veillez entrer votre mot de passe pour y accéder.</p>
    
    <%= form_with url: album_authenticate_path(@album), class: "space-4" do |form| %>
       <% if flash[:alert] %>
        <p class="text-red-500 font-medium"><%= flash[:alert] %></p>
      <% end %>
      <%= form.password_field :password, 
              class: "w-full mb-12 p-3 border-gray-300 form-input rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors", 
              placeholder: "Mot de passe"
      %>
      <div class="flex mt-12">
          <%= form.button type: "submit",
              class: " btn btn-primary justify-center hover:text-blue-600 items-center  flex w-full bottom-7 text-white p-2 rounded-full shadow-md transition duration-300 ease-in-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100" do %>
              Valider
          <% end %>
      </div>
    <% end %>
  </div>
</div>
