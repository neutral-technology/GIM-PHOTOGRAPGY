<div class="min-h-screen flex items-center justify-center p-6"
     style="background:var(--bg)">
  <div class="text-center max-w-md">
    <div class="text-6xl animate-pulse">✨</div>
    <h1 class="text-5xl font-serif mt-6">Bienvenue</h1>
    <p class="text-xl mt-4"><%= @guest.name %></p>
   
    <% if @guest.accepted? %>
      <!-- ENTRY PASS -->
      <div class="mt-10 panel shadow-xl">
        <h2 class="uppercase tracking-[.3em] text-sm">
          Le Pass d'entrée
        </h2>
        <div class="mt-6 flex justify-center">
          <%= image_tag qr_code_for(
                invitation_url(@guest.token)
              ),
              class:"w-44 h-44" %>
        </div>
        <div class="mt-6 text-lg">
          Table
          <strong> <%= @guest.table %> </strong>
        </div>
        <% if @guest.checked_in? %>
          <div class="mt-5 text-green-600 font-bold">
            ✓ Entrée validée
          </div>
        <% else %>
          <div class="mt-5 text-yellow-600 text-md">
            Présentez ce QR code à l'entrée
          </div>
        <% end %>
      </div>

      <!-- STILL ACCESS INVITATION -->
      <%= link_to "Voir mon invitation",
          invitation_path(@guest.token),
          class:"mt-8 inline-block px-8 py-4 rounded-full text-white",
          style:"background:var(--primary)" %>
    <% else %>
      <p class="mt-8 leading-relaxed">
        Votre invitation personnalisée est prête.
        Ouvrez-la et confirmez votre présence
        sur la dernière page ou la dernière
      </p>

      <%= link_to "Ouvrir mon invitation",
          invitation_path(@guest.token),
          class:"mt-10 inline-block px-8 py-4 bg-info-light rounded-full text-info",
          style:"" %>
    <% end %>
  </div>
</div>