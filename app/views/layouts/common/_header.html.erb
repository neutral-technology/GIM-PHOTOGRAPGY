<header class="fixed top-0 z-100 w-full" style="z-index: 999;" :class="{ $store.app.menu === 'horizontal' }">
    <div class="shadow-lg border-b">
        <div class="relative justify-between bg-white flex w-full items-center px-5 py-2.5">
            <div class="horizontal-logo flex justify-between items-center ltr:mr-2 rtl:ml-2">
                <a href="/" class="main-logo items-center shrink-0 bg-black w-20 h-auto">
                    <%= image_tag "GIM2.png", alt: "GIM Service Logo", class: "w-full object-contain" %>
                    <%# <img class="  w-full object-cover" src="/assets/images/GIM2.png" alt="image" /> %>
                </a>
            </div>
            <div class="sm:block">
                <ul class="flex items-center space-x-2 rtl:space-x-reverse">
                    <li><a href="/" class="block p-2 hover:text-primary">
                        Acceuil
                        </a>
                    </li>
                    <li>
                        <a href="/albums" class="block p-2 hover:text-primary dark:hover:bg-dark/60">
                            Albums
                        </a>
                    </li>
                </ul>
            </div>
            <div x-data="" class="ltr:sm:ml-0 ltr:ml-auto sm:rtl:mr-0 rtl:mr-auto flex items-center space-x-1.5 lg:space-x-2 rtl:space-x-reverse dark:text-[#d0d2d6]">
                <div class="dropdown flex-shrink-0" x-data="dropdown" @click.outside="open = false">
                    <a href="javascript:;" class="relative group" @click="toggle()">
                        <span class="text-black font-bold flex items-center">Compte </span>
                    </a>
                        <ul x-cloak x-show="open" x-transition x-transition.duration.300ms class="ltr:right-0 rtl:left-0 text-dark dark:text-white-dark top-11 !py-0 w-[240px] font-semibold dark:text-white-light/90">
                            <% if user_signed_in? %>
                            <li>
                                <div class="gap-2 flex flex-col items-center justify-between border-b">
                                    <div class="flex-shrink-0 main-logo flex items-center justify-center bg-black w-full h-20 rounded">
                                        <%= image_tag "GIM2.png", alt: "Studio Logo", class: "w h-auto object-contain" %>
                                    </div>
                                    <div class="text-sm w-full px-4">
                                        <%# <h4 class="p-1 font-bold text-xs text-gray-800 dark:text-white"><%= current_user.full_name.upcase %><%# </h4> %>
                                        <p class="p-1 text-gray-600 dark:text-gray-300"><%= current_user.email %></p>
                                        <p class="p-1 text-gray-600 dark:text-gray-300"><%= current_user.tel %></p>
                                        <p class="p-1 text-gray-600 dark:text-gray-300"><%= current_user.city || 'Av ... Q...' %></p>
                                        <p class="p-1 text-gray-600 dark:text-gray-300">Fidélité à : <%= current_user.vip_threshold %> FC</p>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <a href="/users/profile" class="dark:hover:text-white" @click="toggle">
                                    <svg class="w-4.5 h-4.5 ltr:mr-2 rtl:ml-2" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <circle cx="12" cy="6" r="4" stroke="currentColor" stroke-width="1.5" />
                                        <path opacity="0.5" d="M20 17.5C20 19.9853 20 22 12 22C4 22 4 19.9853 4 17.5C4 15.0147 7.58172 13 12 13C16.4183 13 20 15.0147 20 17.5Z" stroke="currentColor" stroke-width="1.5" />
                                    </svg>
                                    Paneau de contrôle</a>
                            </li>
                            <li>
                                <%= link_to edit_user_registration_path, class: "dark:hover:text-white" do %>
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 ltr:mr-2 rtl:ml-2" width="18" height="18" viewBox="0 0 24 24" fill="none">
                                        <path opacity="0.5" d="M4 22H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                        <path d="M14.6296 2.92142L13.8881 3.66293L7.07106 10.4799C6.60933 10.9416 6.37846 11.1725 6.17992 11.4271C5.94571 11.7273 5.74491 12.0522 5.58107 12.396C5.44219 12.6874 5.33894 12.9972 5.13245 13.6167L4.25745 16.2417L4.04356 16.8833C3.94194 17.1882 4.02128 17.5243 4.2485 17.7515C4.47573 17.9787 4.81182 18.0581 5.11667 17.9564L5.75834 17.7426L8.38334 16.8675L8.3834 16.8675C9.00284 16.6611 9.31256 16.5578 9.60398 16.4189C9.94775 16.2551 10.2727 16.0543 10.5729 15.8201C10.8275 15.6215 11.0583 15.3907 11.5201 14.929L11.5201 14.9289L18.3371 8.11195L19.0786 7.37044C20.3071 6.14188 20.3071 4.14999 19.0786 2.92142C17.85 1.69286 15.8581 1.69286 14.6296 2.92142Z" stroke="currentColor" stroke-width="1.5" />
                                        <path opacity="0.5" d="M13.8879 3.66406C13.8879 3.66406 13.9806 5.23976 15.3709 6.63008C16.7613 8.0204 18.337 8.11308 18.337 8.11308M5.75821 17.7437L4.25732 16.2428" stroke="currentColor" stroke-width="1.5" />
                                    </svg>
                                Parametre
                                <% end %>
                            </li>
                            <li class="border-t border-white-light dark:border-white-light/10">
                            <%= button_to destroy_user_session_path, class: "text-center text-danger !py-3 w-full flex gap-1", method: :delete, data: {turbo:false} do %>
                                <svg class="w-4.5 ml-3 h-4.5 ltr:mr-2 rtl:ml-2 rotate-90" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path opacity="0.5" d="M17 9.00195C19.175 9.01406 20.3529 9.11051 21.1213 9.8789C22 10.7576 22 12.1718 22 15.0002V16.0002C22 18.8286 22 20.2429 21.1213 21.1215C20.2426 22.0002 18.8284 22.0002 16 22.0002H8C5.17157 22.0002 3.75736 22.0002 2.87868 21.1215C2 20.2429 2 18.8286 2 16.0002L2 15.0002C2 12.1718 2 10.7576 2.87868 9.87889C3.64706 9.11051 4.82497 9.01406 7 9.00195" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path d="M12 15L12 2M12 2L15 5.5M12 2L9 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Déconnecter
                            <% end %>
                        </li>
                    <% else %>
                        <li>
                            <a href="/users/sign_up" class="block p-2 hover:text-primary font-normal">
                                Créer compte
                            </a>
                        </li>
                        <li>
                            <a href="/users/sign_in" class="block p-2 hover:text-primary font-normal">
                            Se connecter
                            </a>
                        </li>
                        
                    <% end %>
                        </ul>
                </div>
            </div>
        </div>
    </div>
</header>

