<%# app/views/layouts/pdf.html.erb %>
<!DOCTYPE html>
<html>
  <head>
    <%= stylesheet_link_tag "pdf", media: "all" %>
    
    <meta charset="UTF-8">
    <style>
      body { 
        -webkit-print-color-adjust: exact !important; 
        print-color-adjust: exact !important;
      }
      .page-break { page-break-after: always; break-after: page; }
    </style>
  </head>
  <body class="">
    <main>
      <%= yield %>
    </main>
  </body>
</html>