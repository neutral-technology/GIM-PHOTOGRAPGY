<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    
    <style>
      /* Cette ligne injecte le CSS que ce soit en HTML ou en PDF */
      <%= @css_content.html_safe if @css_content.present? %>

      @page { size: A4; margin: 0; }
      body { 
        -webkit-print-color-adjust: exact !important; 
        print-color-adjust: exact !important;
      }
      .page-break { page-break-after: always; break-after: page; }
    </style>
  </head>
  <body class="bg-white">
    <main>
      <%= yield %>
    </main>
  </body>
</html>